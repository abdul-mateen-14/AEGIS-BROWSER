# Aegis Browser - free CI gn args (Android arm64)
#
# Goal: fit a full Chromium APK build into a 4 vCPU / 16 GB GitHub-hosted
# runner with a 6-hour job cap. Each flag below exists to cut RAM or time:
#
#   is_official_build = false : official builds enable ThinLTO + PGO; the
#                               final link alone can want 20-30+ GB RAM and
#                               add 1-2 h. Unofficial is still -O2 optimized.
#   use_thin_lto = false      : removes ThinLTO from the link (the biggest
#                               memory spike).
#   chrome_pgo_phase = 0      : no Profile-Guided Optimization data pass.
#   symbol_level = 0          : no native debug symbols -> much smaller
#                               build directory (saves ~20+ GB disk).
#   v8_symbol_level = 0       : same, for the V8 engine.
#   blink_symbol_level = 0    : same, for the Blink renderer (defaults to 2
#                               even when symbol_level=0 in some configs).
#   is_component_build=false  : release-style static build (correct for APKs).
#   disable_fieldtrial_testing_config : no experiment configs; predictable.
#   ffmpeg_branding="Chrome" + proprietary_codecs=true : H.264/AAC etc., as
#                               shipped in Chrome and every public fork.
#   cc_wrapper = "/usr/local/bin/aegis_atomic_cc" : atomic-output compile
#                               wrapper (aegis/ci/atomic_cc.c). NOTE: ccache
#                               is useless here - Chromium 156 compiles all
#                               C++ with C++20 modules (clang PCM), which
#                               ccache cannot cache (it passes module units
#                               straight through). The wrapper instead makes
#                               every -o output atomic (temp file + rename on
#                               success), so a run killed at the 6 h cap never
#                               leaves a half-written .o/.pcm for the next
#                               run's ninja to trust. That is what makes the
#                               build-tree bank (draft-release volumes, see
#                               aegis/ci/bank.sh) safe to restore.
#
# If you later build on a machine with 32 GB+ RAM, flip is_official_build
# to true and drop the use_thin_lto / chrome_pgo_phase lines for a
# smaller, faster binary.

target_os = "android"
target_cpu = "arm64"
is_debug = false
is_official_build = true
is_component_build = false
symbol_level = 0
v8_symbol_level = 0
blink_symbol_level = 0
use_thin_lto = false
# chrome_pgo_phase = 0 : the free-runner hooks do not fetch the published
# PGO profiles (cipd pgo_profiles hook), so phase 2 fails fast at gn gen
# with "requested profile ... does not exist". Keep PGO off here.
chrome_pgo_phase = 0
disable_fieldtrial_testing_config = true
ffmpeg_branding = "Chrome"
proprietary_codecs = true
cc_wrapper = "/usr/local/bin/aegis_atomic_cc"

# use_siso = false : the bank/resume design (aegis/ci/bank.sh v6 mtime
# contract) requires NINJA state - v6 .ninja_log + real .ninja_deps.
# Chromium 156 defaults to SISO (infra PSA switched the default), which
# writes a v5-compat .ninja_log ninja>=1.12 discards and NO .ninja_deps,
# so every restored tree replans 100% dirty every window (observed:
# linux plan-at-start pinned at 96.3k across #41/#42, win 58.5k full-dirty
# per [why-dirty]; bank warned ".ninja_log is v5 / no usable .ninja_deps").
# Siso burned 29-45k edges/window without ever shrinking the next plan -
# no window can ever reach the graph end that way. Forcing ninja makes
# the v6 contract hold: window N+1 resumes with only genuinely dirty edges.
use_siso = false

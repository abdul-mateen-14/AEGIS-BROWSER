# Aegis Browser - free CI gn args (Linux x64 desktop)
#
# Same low-RAM family as arm64.gn, aimed at the desktop Linux target on a
# 4 vCPU / 16 GB GitHub-hosted runner with the 6-hour job cap:
#
#   is_official_build = false : no ThinLTO + PGO (the multi-GB RAM link spike);
#                               the binary is still -O2 optimized.
#   symbol_level = 0 / v8_symbol_level = 0 / blink_symbol_level = 0 :
#                               no debug symbols -> far smaller out/ dir.
#   is_component_build = false: one static binary, correct for packaging.
#   disable_fieldtrial_testing_config : no experiment configs; predictable.
#   ffmpeg_branding="Chrome" + proprietary_codecs=true : H.264/AAC etc. as
#                               shipped in Chrome and every public fork.
#   cc_wrapper = "/usr/local/bin/aegis_atomic_cc" : atomic-output compile
#                               wrapper (aegis/ci/atomic_cc.c). NOTE: ccache
#                               is useless here - Chromium 156 compiles all
#                               C++ with C++20 modules (clang PCM), which
#                               ccache cannot cache (it passes module units
#                               straight through). The wrapper instead makes
#                               every -o output atomic (temp file + rename on
#                               success), so a run killed at the 6 h cap never
#                               leaves a half-written .o/.pcm for the next
#                               run's ninja to trust. That is what makes the
#                               build-tree bank (draft-release volumes, see
#                               aegis/ci/bank.sh) safe to restore.
#
# A desktop Linux build is LIGHTER than the Android APK build (no Java
# targets, no APK packaging).

target_os = "linux"
target_cpu = "x64"
is_debug = false
is_official_build = false
is_component_build = false
symbol_level = 0
v8_symbol_level = 0
blink_symbol_level = 0
use_thin_lto = false
chrome_pgo_phase = 0
disable_fieldtrial_testing_config = true
ffmpeg_branding = "Chrome"
proprietary_codecs = true
cc_wrapper = "/usr/local/bin/aegis_atomic_cc"

+    /** Patch 162: favicon loads ride a shared per-profile bridge; the
+     *  sheet is transient, so the bridges live at process scope. */
+    private static final Handler sUi = new Handler(Looper.getMainLooper());
+    private static LargeIconBridge sRegularBridge;
+    private static LargeIconBridge sIncognitoBridge;
+
+    private static LargeIconBridge bridgeFor(Tab tab) {
+        if (tab.isIncognito()) {
+            if (sIncognitoBridge == null) {
+                sIncognitoBridge = new LargeIconBridge(tab.getProfile());
+            }
+            return sIncognitoBridge;
+        }
+        if (sRegularBridge == null) {
+            sRegularBridge = new LargeIconBridge(tab.getProfile());
+        }
+        return sRegularBridge;
+    }
+
+    /** Loads the tab favicon into {@code icon}; a letter tile stays on a
+     *  miss. Mirrors AegisHomeView.fetchFavicon's proven callback shape. */
+    private void bindFavicon(Tab tab, ImageView icon, boolean private_) {
+        if (tab.getUrl() == null) return;
+        try {
+            bridgeFor(tab)
+                    .getLargeIconForUrl(
+                            tab.getUrl(),
+                            (int) (48 * getResources().getDisplayMetrics().density),
+                            (bmp, fallbackColor, isDefaultColor, iconType) -> {
+                                sUi.post(
+                                        () -> {
+                                            if (bmp != null && !bmp.isRecycled()) {
+                                                icon.setImageBitmap(bmp);
+                                            } else if (fallbackColor != 0) {
+                                                icon.setImageBitmap(
+                                                        letterTile(tab,
+                                                                fallbackColor | 0xFF000000,
+                                                                private_));
+                                            }
+                                        });
+                            });
+        } catch (RuntimeException faviconError) {
+            // The plain tile stays; a favicon must never break the sheet.
+        }
+    }
+
+    /** A quiet neutral tile shown before the favicon resolves. */
+    private Bitmap plainTile(boolean private_) {
+        int size = (int) (26 * getResources().getDisplayMetrics().density);
+        Bitmap bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bmp);
+        Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        paint.setColor(getContext().getColor(
+                private_ ? R.color.aegis_surface_inverted : R.color.aegis_glass_chip));
+        canvas.drawCircle(size / 2f, size / 2f, size / 2f, paint);
+        return bmp;
+    }
+
+    /** Letter tile in the favicon's generated color (patch 130 style). */
+    private Bitmap letterTile(Tab tab, int bgColor, boolean private_) {
+        int size = (int) (26 * getResources().getDisplayMetrics().density);
+        Bitmap bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bmp);
+        Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        paint.setColor(bgColor);
+        canvas.drawCircle(size / 2f, size / 2f, size / 2f, paint);
+        String label = tab.getTitle() == null || tab.getTitle().isEmpty()
+                ? "A" : tab.getTitle().trim();
+        double lum = 0.2126 * Color.red(bgColor) + 0.7152 * Color.green(bgColor)
+                + 0.0722 * Color.blue(bgColor);
+        paint.setColor(lum > 140
+                ? getContext().getColor(R.color.aegis_text_primary)
+                : getContext().getColor(
+                        private_ ? R.color.aegis_text_primary_inverted
+                                 : R.color.aegis_text_primary));
+        paint.setTextSize(size * 0.52f);
+        paint.setTextAlign(Paint.Align.CENTER);
+        paint.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL));
+        Paint.FontMetrics fm = paint.getFontMetrics();
+        float textY = size / 2f - (fm.ascent + fm.descent) / 2f;
+        canvas.drawText(label.substring(0, 1).toUpperCase(java.util.Locale.ROOT),
+                size / 2f, textY, paint);
+        return bmp;
+    }

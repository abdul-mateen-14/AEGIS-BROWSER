+    /** AEGIS (patch 177): the brand mark as the fallback chip. */
+    private static Bitmap aegis(int sizePx, boolean dark) {
+        Bitmap bmp = Bitmap.createBitmap(sizePx, sizePx, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bmp);
+        Paint p = paintOf(dark ? 0xFFF2F3F7 : 0xFF101114);
+        p.setStyle(Paint.Style.STROKE);
+        p.setStrokeWidth(sizePx * 0.09f);
+        p.setStrokeJoin(Paint.Join.ROUND);
+        float s = sizePx;
+        Path big = new Path();
+        big.moveTo(s * 0.50f, s * 0.13f);
+        big.lineTo(s * 0.15f, s * 0.87f);
+        big.lineTo(s * 0.85f, s * 0.87f);
+        big.close();
+        canvas.drawPath(big, p);
+        Path nested = new Path();
+        nested.moveTo(s * 0.63f, s * 0.42f);
+        nested.lineTo(s * 0.48f, s * 0.76f);
+        nested.lineTo(s * 0.83f, s * 0.76f);
+        nested.close();
+        canvas.drawPath(nested, p);
+        p.setStyle(Paint.Style.FILL);
+        Path bar = new Path();
+        bar.moveTo(s * 0.10f, s * 0.76f);
+        bar.lineTo(s * 0.66f, s * 0.76f);
+        bar.lineTo(s * 0.56f, s * 0.93f);
+        bar.lineTo(s * 0.20f, s * 0.93f);
+        bar.close();
+        canvas.drawPath(bar, p);
+        return bmp;
+    }
+
 }

+package org.chromium.chrome.browser.aegis.dock;
+
+import android.os.Handler;
+import android.os.Looper;
+import android.view.View;
+
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.ChromeTabbedActivity;
+import org.chromium.chrome.browser.toolbar.top.ToolbarControlContainer;
+
+/**
+ * Aegis full-screen browsing (patch 124): the top control container is the
+ * "header with address bar" that the dock replaces. Patch 080 hid it once
+ * at startup, but the browser-controls machinery can bring it back later;
+ * this hides it and re-asserts the hidden state every second for the whole
+ * session. The reported top-controls height is zeroed (see
+ * ToolbarControlContainer.sAegisZeroHeight) so page content is laid out
+ * full screen below the status bar with no reserved strip.
+ */
+public final class AegisTopToolbar {
+    private static final long REASSERT_MS = 1000;
+    private static final Handler sHandler = new Handler(Looper.getMainLooper());
+    private static View sControlContainer;
+
+    private AegisTopToolbar() {}
+
+    /** Hides the top control container; keeps it hidden for the session. */
+    public static void hide(ChromeTabbedActivity activity) {
+        sControlContainer = activity.findViewById(R.id.control_container);
+        if (sControlContainer != null) sControlContainer.setVisibility(View.GONE);
+        View bottom = activity.findViewById(R.id.bottom_container);
+        if (bottom != null) bottom.setVisibility(View.GONE);
+        ToolbarControlContainer.sAegisZeroHeight = true;
+        sHandler.postDelayed(AegisTopToolbar::reassert, REASSERT_MS);
+    }
+
+    private static void reassert() {
+        if (sControlContainer != null
+                && sControlContainer.getVisibility() != View.GONE) {
+            sControlContainer.setVisibility(View.GONE);
+        }
+        sHandler.postDelayed(AegisTopToolbar::reassert, REASSERT_MS);
+    }
+}

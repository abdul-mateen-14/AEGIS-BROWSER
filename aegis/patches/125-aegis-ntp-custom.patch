+    /** Loads the stored tile list; defaults when unset or unreadable. */
+    private List<String[]> loadTiles() {
+        List<String[]> tiles = new ArrayList<>();
+        String raw = ContextUtils.getAppSharedPreferences().getString(PREF_TILES, null);
+        if (raw != null) {
+            try {
+                org.json.JSONArray arr = new org.json.JSONArray(raw);
+                for (int i = 0; i < arr.length(); i++) {
+                    org.json.JSONObject o = arr.getJSONObject(i);
+                    String label = o.optString("label", "");
+                    String url = o.optString("url", "");
+                    if (!label.isEmpty() && !url.isEmpty()) {
+                        tiles.add(new String[] {label, url});
+                    }
+                }
+                return tiles;
+            } catch (org.json.JSONException e) {
+                // Fall through to the default set.
+            }
+        }
+        tiles.add(new String[] {"aegis.dev", "https://aegis.dev"});
+        tiles.add(new String[] {"wikipedia", "https://wikipedia.org"});
+        tiles.add(new String[] {"github", "https://github.com"});
+        tiles.add(new String[] {"duckduckgo", "https://duckduckgo.com"});
+        return tiles;
+    }

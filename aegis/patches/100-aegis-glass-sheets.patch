+// Copyright 2026 The Aegis Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.aegis.dock;
+
+import android.graphics.Typeface;
+import android.view.Gravity;
+import android.view.ViewGroup;
+import android.widget.GridLayout;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.ChromeTabbedActivity;
+
+/**
+ * Aegis glass menu sheet (patch 100, spec Table 4): the page context header
+ * (domain + hardened pill) over a 4 x 2 grid of quiet, monochrome quick
+ * actions. The dock menu button is its only entry point; a downward fling on
+ * the scrim dismisses it. Each tile reuses the browser's own menu action
+ * ids, so behavior and metrics stay stock.
+ */
+@NullMarked
+public class AegisMenuSheet extends AegisGlassSheet {
+    private AegisMenuSheet(AegisDockView dock) {
+        super(dock);
+    }
+
+    /** Opens the menu sheet over {@code dock}'s activity. */
+    public static void show(AegisDockView dock) {
+        AegisMenuSheet sheet = new AegisMenuSheet(dock);
+        sheet.buildPanel();
+        present(dock, sheet);
+    }
+
+    private void buildPanel() {
+        // Page context header: domain + hardened-by-default pill (spec 2.2:
+        // the URL pill is the only chrome allowed to speak about trust).
+        TextView domain = new TextView(getContext());
+        domain.setText(currentDomain());
+        domain.setTextSize(16);
+        domain.setTypeface(domain.getTypeface(), Typeface.BOLD);
+        domain.setTextColor(getContext().getColor(R.color.aegis_text_primary));
+        mPanel.addView(domain);
+
+        TextView status = new TextView(getContext());
+        status.setText(getContext().getString(R.string.aegis_menu_status));
+        status.setTextSize(10);
+        status.setLetterSpacing(0.08f);
+        status.setAllCaps(true);
+        status.setTypeface(status.getTypeface(), Typeface.BOLD);
+        status.setTextColor(getContext().getColor(R.color.aegis_text_secondary));
+        status.setPadding(0, 4, 0, 12);
+        mPanel.addView(status);
+
+        ScrollView scroll = new ScrollView(getContext());
+        scroll.setVerticalScrollBarEnabled(false);
+        GridLayout grid = new GridLayout(getContext());
+        grid.setColumnCount(4);
+        int gap = (int) (6 * getResources().getDisplayMetrics().density);
+        addTile(grid, R.string.aegis_menu_new_tab, R.drawable.aegis_ic_plus,
+                () -> fire(R.id.new_tab_menu_id));
+        addTile(grid, R.string.aegis_menu_private_tab, R.drawable.aegis_ic_incognito,
+                () -> fire(R.id.new_incognito_tab_menu_id));
+        addTile(grid, R.string.aegis_menu_history, R.drawable.aegis_ic_history,
+                () -> fire(R.id.open_history_menu_id));
+        addTile(grid, R.string.aegis_menu_downloads, R.drawable.aegis_ic_download,
+                () -> fire(R.id.downloads_menu_id));
+        addTile(grid, R.string.aegis_menu_bookmarks, R.drawable.aegis_ic_bookmark,
+                () -> fire(R.id.all_bookmarks_menu_id));
+        addTile(grid, R.string.aegis_menu_reading_list, R.drawable.aegis_ic_reading,
+                () -> fire(R.id.show_reading_list_menu_id));
+        addTile(grid, R.string.aegis_menu_desktop_site, R.drawable.aegis_ic_desktop,
+                () -> fire(R.id.request_desktop_site_id));
+        addTile(grid, R.string.aegis_menu_settings, R.drawable.aegis_ic_settings,
+                () -> {
+                    dismiss();
+                    org.chromium.chrome.browser.settings.SettingsNavigationFactory
+                            .createSettingsNavigation()
+                            .startSettings(
+                                    (android.app.Activity) dock().getContext(),
+                                    org.chromium.chrome.browser.settings.MainSettings.class);
+                });
+        scroll.addView(grid);
+        mPanel.addView(
+                scroll,
+                new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT));
+    }
+
+    private void addTile(GridLayout grid, int labelRes, int iconRes, Runnable action) {
+        int density = (int) getResources().getDisplayMetrics().density;
+        LinearLayout tile = new LinearLayout(getContext());
+        tile.setOrientation(LinearLayout.VERTICAL);
+        tile.setGravity(Gravity.CENTER);
+        tile.setPadding(density * 4, density * 10, density * 4, density * 10);
+        tile.setClickable(true);
+        tile.setFocusable(true);
+        tile.setOnClickListener(v -> action.run());
+
+        android.widget.ImageView icon = new android.widget.ImageView(getContext());
+        icon.setImageResource(iconRes);
+        LinearLayout.LayoutParams iconLp =
+                new LinearLayout.LayoutParams(density * 21, density * 21);
+        iconLp.gravity = Gravity.CENTER_HORIZONTAL;
+        icon.setLayoutParams(iconLp);
+        tile.addView(icon);
+
+        TextView label = new TextView(getContext());
+        label.setText(labelRes);
+        label.setTextSize(11);
+        label.setTextColor(getContext().getColor(R.color.aegis_text_secondary));
+        label.setGravity(Gravity.CENTER);
+        label.setMaxLines(2);
+        LinearLayout.LayoutParams labelLp =
+                new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT);
+        labelLp.topMargin = density * 6;
+        tile.addView(label, labelLp);
+
+        GridLayout.LayoutParams glp = new GridLayout.LayoutParams(
+                GridLayout.spec(GridLayout.UNDEFINED, 1f),
+                GridLayout.spec(GridLayout.UNDEFINED, 1f));
+        tile.setLayoutParams(glp);
+        grid.addView(tile);
+    }
+
+    private void fire(int menuId) {
+        dismiss();
+        ChromeTabbedActivity cta = (ChromeTabbedActivity) dock().getContext();
+        cta.onMenuOrKeyboardAction(
+                menuId, /* fromMenu= */ false,
+                /* menuItemData= */ null, /* triggeringMotion= */ null);
+    }
+
+    private String currentDomain() {
+        ChromeTabbedActivity cta = (ChromeTabbedActivity) dock().getContext();
+        android.content.Context ctx = dock().getContext();
+        try {
+            if (cta.getActivityTab() != null && cta.getActivityTab().getUrl() != null) {
+                String host = cta.getActivityTab().getUrl().getHost();
+                if (host != null && !host.isEmpty()) return host;
+            }
+        } catch (Exception e) {
+            // The header falls back to the product name off-browser.
+        }
+        return ctx.getString(R.string.aegis_menu_home);
+    }
+}
+


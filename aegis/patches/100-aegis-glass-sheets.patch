+// Copyright 2026 The Aegis Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.aegis.dock;
+
+import android.graphics.drawable.GradientDrawable;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.GridLayout;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.ChromeTabbedActivity;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tab.TabSelectionType;
+import org.chromium.chrome.browser.tabmodel.TabModel;
+import org.chromium.chrome.browser.tabmodel.TabModelUtils;
+
+/**
+ * Aegis glass tab grid (patch 100, spec Table 4): two-column cards over the
+ * live page, private tabs inverted, a "New tab" pill in the footer. Entry:
+ * swipe up on the dock or the Tabs tile in the menu sheet; dismiss with a
+ * downward fling on the scrim or tapping a card (switches to that tab).
+ */
+@NullMarked
+public class AegisTabGridSheet extends AegisGlassSheet {
+    private AegisTabGridSheet(AegisDockView dock) {
+        super(dock);
+    }
+
+    /** Opens the tab grid over {@code dock}'s activity. */
+    public static void show(AegisDockView dock) {
+        AegisTabGridSheet sheet = new AegisTabGridSheet(dock);
+        sheet.buildPanel();
+        present(dock, sheet);
+    }
+
+    private void buildPanel() {
+        TextView title = new TextView(getContext());
+        title.setText(getContext().getString(R.string.aegis_sheet_tabs_title));
+        title.setTextSize(16);
+        title.setTypeface(title.getTypeface(), android.graphics.Typeface.BOLD);
+        title.setTextColor(getContext().getColor(R.color.aegis_text_primary));
+        title.setPadding(0, 0, 0, 12);
+        mPanel.addView(title);
+
+        ScrollView scroll = new ScrollView(getContext());
+        scroll.setVerticalScrollBarEnabled(false);
+        GridLayout grid = new GridLayout(getContext());
+        grid.setColumnCount(2);
+        int gap = (int) (8 * getResources().getDisplayMetrics().density);
+        ChromeTabbedActivity cta = (ChromeTabbedActivity) dock().getContext();
+        int added = 0;
+        for (int modelIndex = 0; modelIndex < 2; modelIndex++) {
+            TabModel model = cta.getTabModelSelector().getModel(modelIndex == 1);
+            if (model == null) continue;
+            boolean private_ = model.isIncognito();
+            int count = model.getTabCountSupplier().get();
+            for (int i = 0; i < count; i++) {
+                Tab tab = model.getTabAt(i);
+                if (tab == null) continue;
+                GridLayout.LayoutParams glp = new GridLayout.LayoutParams(
+                        GridLayout.spec(GridLayout.UNDEFINED, 1f),
+                        GridLayout.spec(GridLayout.UNDEFINED, 1f));
+                glp.setMargins(gap / 2, gap / 2, gap / 2, gap / 2);
+                grid.addView(tabCard(tab, private_), glp);
+                added++;
+            }
+        }
+        if (added == 0) {
+            TextView empty = new TextView(getContext());
+            empty.setText(getContext().getString(R.string.aegis_sheet_tabs_empty));
+            empty.setTextSize(13);
+            empty.setTextColor(getContext().getColor(R.color.aegis_text_secondary));
+            empty.setPadding(0, 8, 0, 8);
+            grid.addView(empty, new GridLayout.LayoutParams(
+                    GridLayout.spec(GridLayout.UNDEFINED, 2),
+                    GridLayout.spec(GridLayout.UNDEFINED, 1)));
+        }
+        scroll.addView(grid);
+        mPanel.addView(
+                scroll,
+                new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        mPanel.addView(newTabPill());
+    }
+
+    private View tabCard(Tab tab, boolean private_) {
+        LinearLayout card = new LinearLayout(getContext());
+        card.setOrientation(LinearLayout.VERTICAL);
+        card.setPadding(12, 12, 12, 12);
+        card.setClickable(true);
+        card.setFocusable(true);
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(getContext().getColor(
+                private_ ? R.color.aegis_surface_inverted : R.color.aegis_surface));
+        bg.setCornerRadius(getResources().getDisplayMetrics().density * 16);
+        bg.setStroke(1, getContext().getColor(R.color.aegis_hairline));
+        card.setBackground(bg);
+        card.setMinimumHeight((int) (88 * getResources().getDisplayMetrics().density));
+
+        TextView title = new TextView(getContext());
+        title.setText(tab.getTitle());
+        title.setTextSize(13);
+        title.setTextColor(getContext().getColor(
+                private_ ? R.color.aegis_text_primary_inverted : R.color.aegis_text_primary));
+        title.setMaxLines(2);
+        title.setEllipsize(android.text.TextUtils.TruncateAt.END);
+        card.addView(title);
+
+        TextView host = new TextView(getContext());
+        String url = tab.getUrl() != null ? tab.getUrl().getHost() : "";
+        host.setText(url.isEmpty() ? getContext().getString(R.string.aegis_dock_search_hint)
+                                   : url);
+        host.setTextSize(11);
+        host.setTextColor(getContext().getColor(
+                private_ ? R.color.aegis_text_secondary_inverted : R.color.aegis_text_secondary));
+        card.addView(host);
+
+        card.setOnClickListener(v -> {
+            TabModelUtils.selectTabById(
+                    ((ChromeTabbedActivity) dock().getContext()).getTabModelSelector(),
+                    tab.getId(),
+                    TabSelectionType.FROM_USER);
+            dismiss();
+        });
+        return card;
+    }
+
+    private View newTabPill() {
+        TextView pill = new TextView(getContext());
+        pill.setText(getContext().getString(R.string.aegis_dock_new_tab));
+        pill.setTextSize(13);
+        pill.setTextColor(getContext().getColor(R.color.aegis_accent_on));
+        pill.setGravity(Gravity.CENTER);
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(getContext().getColor(R.color.aegis_accent));
+        bg.setCornerRadius(getResources().getDisplayMetrics().density * 24);
+        pill.setBackground(bg);
+        int pad = (int) (12 * getResources().getDisplayMetrics().density);
+        pill.setPadding(pad, pad / 2, pad, pad / 2);
+        LinearLayout.LayoutParams lp =
+                new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT);
+        lp.gravity = Gravity.CENTER_HORIZONTAL;
+        lp.topMargin = pad;
+        pill.setOnClickListener(v -> {
+            ChromeTabbedActivity cta = (ChromeTabbedActivity) dock().getContext();
+            cta.onMenuOrKeyboardAction(
+                    R.id.new_tab_menu_id, /* fromMenu= */ false,
+                    /* menuItemData= */ null, /* triggeringMotion= */ null);
+            dismiss();
+        });
+        return pill;
+    }
+}
+


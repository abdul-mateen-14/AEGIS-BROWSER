+package org.chromium.chrome.browser.aegis.dock;
+
+import android.app.Activity;
+import android.graphics.drawable.GradientDrawable;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.ViewGroup;
+import android.view.ViewTreeObserver;
+import android.view.animation.PathInterpolator;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.R;
+
+/**
+ * Aegis glass sheet base (patch 100, spec section 04): the one material all
+ * overlays are made of. A translucent full-screen scrim over the activity
+ * content with a bottom panel in the same glass recipe as the dock. Sheets
+ * rise from the bottom edge (380 ms), cap at 75% of the viewport (content
+ * scrolls inside the panel), and dismiss on a downward fling or scrim tap.
+ */
+@NullMarked
+public abstract class AegisGlassSheet extends FrameLayout {
+    /** Sheet rise duration, in ms (spec Table 9). */
+    private static final long RISE_MS = 380;
+    private static final long FALL_MS = 240;
+    /** Sheets cap at 75% of the viewport height (spec Table 4). */
+    private static final float CAP_FRACTION = 0.75f;
+
+    /** The currently showing sheet, or null. Holds the dock open under it. */
+    private static AegisGlassSheet sShowing;
+
+    protected final LinearLayout mPanel;
+    private final AegisDockView mDock;
+    private float mDownY;
+    private boolean mDismissed;
+
+    protected AegisGlassSheet(AegisDockView dock) {
+        super(dock.getContext());
+        mDock = dock;
+        setBackgroundColor(getContext().getColor(R.color.aegis_glass_scrim));
+        setClickable(true);
+        setOnClickListener(v -> dismiss());
+
+        mPanel = new LinearLayout(getContext());
+        mPanel.setOrientation(LinearLayout.VERTICAL);
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(getContext().getColor(R.color.aegis_glass_sheet));
+        float corner = getContext().getResources().getDimension(R.dimen.aegis_sheet_corner);
+        bg.setCornerRadii(new float[] {corner, corner, corner, corner, 0f, 0f, 0f, 0f});
+        bg.setStroke(1, getContext().getColor(R.color.aegis_glass_stroke));
+        mPanel.setBackground(bg);
+        int pad = getContext().getResources().getDimensionPixelSize(R.dimen.aegis_sheet_padding);
+        mPanel.setPadding(pad, pad, pad, pad);
+        addView(
+                mPanel,
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                        Gravity.BOTTOM));
+    }
+
+    /** True while any glass sheet covers the page. */
+    public static boolean isAnySheetShowing() {
+        return sShowing != null;
+    }
+
+    /**
+     * Attaches and rises the sheet over the dock's activity content root.
+     * Subclasses build their content into a {@link ScrollView} and pass it
+     * via {@link #sheetContent()} before calling this.
+     */
+    protected static void present(AegisDockView dock, AegisGlassSheet sheet) {
+        Activity activity = (Activity) dock.getContext();
+        ViewGroup content = activity.findViewById(android.R.id.content);
+        if (content == null) return;
+        if (sShowing != null) sShowing.dismiss();
+        sShowing = sheet;
+        sheet.setId(R.id.aegis_search_sheet);
+        content.addView(
+                sheet,
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.MATCH_PARENT));
+        // Cap the panel at 75% of the viewport before the first draw so the
+        // inner scroll view owns anything longer than the cap.
+        ViewTreeObserver.OnPreDrawListener capListener =
+                new ViewTreeObserver.OnPreDrawListener() {
+                    @Override
+                    public boolean onPreDraw() {
+                        sheet.getViewTreeObserver().removeOnPreDrawListener(this);
+                        int cap = (int) (sheet.getHeight() * CAP_FRACTION);
+                        if (sheet.mPanel.getHeight() > cap) {
+                            sheet.mPanel.getLayoutParams().height = cap;
+                            sheet.mPanel.requestLayout();
+                        }
+                        return true;
+                    }
+                };
+        sheet.getViewTreeObserver().addOnPreDrawListener(capListener);
+        // Rise: from below the bottom edge; fast departure, gentle landing.
+        sheet.mPanel.setTranslationY(
+                Math.max(400, sheet.getResources().getDisplayMetrics().heightPixels / 3));
+        sheet.mPanel.animate()
+                .translationY(0f)
+                .setDuration(RISE_MS)
+                .setInterpolator(new PathInterpolator(0.25f, 1f, 0.5f, 1f))
+                .start();
+    }
+
+    /** The scrollable content strip subclasses hand to {@link #present}. */
+    protected abstract ScrollView sheetContent();
+
+    /** Removes the sheet (240 ms fall). */
+    public void dismiss() {
+        if (mDismissed) return;
+        mDismissed = true;
+        if (sShowing == this) sShowing = null;
+        ViewGroup parent = (ViewGroup) getParent();
+        if (parent == null) return;
+        Runnable remove = () -> parent.removeView(AegisGlassSheet.this);
+        if (mAnimate()) {
+            animate().alpha(0f).setDuration(FALL_MS).withEndAction(remove).start();
+        } else {
+            remove.run();
+        }
+    }
+
+    private boolean mAnimate() {
+        return android.provider.Settings.Global.getFloat(
+                        getContext().getContentResolver(),
+                        android.provider.Settings.Global.ANIMATOR_DURATION_SCALE, 1f)
+                > 0f;
+    }
+
+    protected AegisDockView dock() {
+        return mDock;
+    }
+
+    /** Downward fling dismisses (spec Table 4). */
+    @Override
+    public boolean dispatchTouchEvent(MotionEvent event) {
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                mDownY = event.getY();
+                break;
+            case MotionEvent.ACTION_UP:
+                if (event.getY() - mDownY > 260 && !isPointInsidePanel(event)) {
+                    dismiss();
+                    return true;
+                }
+                break;
+            default:
+                break;
+        }
+        return super.dispatchTouchEvent(event);
+    }
+
+    private boolean isPointInsidePanel(MotionEvent event) {
+        // A fling that starts inside the scroll content scrolls the content;
+        // flings on the scrim area dismiss the sheet.
+        int[] xy = new int[2];
+        mPanel.getLocationOnScreen(xy);
+        float y = event.getRawY();
+        return y >= xy[1] && y <= xy[1] + mPanel.getHeight();
+    }
+}
+


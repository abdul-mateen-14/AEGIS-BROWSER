--- a/aegis/ci/restamp.sh
+++ b/aegis/ci/restamp.sh
@@ -28,26 +28,51 @@
 # Usage: restamp.sh <src_dir>      (env: AEGIS_SRC_EPOCH, same as bank.sh)
 set -u
 SRC="${1:?src_dir}"
+AEGIS_PATCH_DIR="${2:-$(dirname "$0")/../patches}"
 EPOCH="${AEGIS_SRC_EPOCH:-1577836800}"   # 2020-01-01T00:00:00Z
 # python stamps a ~500k-file tree 5-10x faster than find|xargs touch (windows
 # process spawn is expensive); identical semantics, find|xargs as fallback.
 PY="python3"; command -v python3 >/dev/null 2>&1 || PY="python"
 stamp_tree() {
-  "$PY" - "$SRC" "$EPOCH" <<'STAMPEOF'
-import os, sys
-src, epoch = sys.argv[1], int(sys.argv[2]) * 1000000000
+  "$PY" - "$SRC" "$EPOCH" "${AEGIS_PATCH_DIR:-}" <<'STAMPEOF'
+import glob, os, sys
+src, epoch, patch_dir = sys.argv[1], int(sys.argv[2]) * 1000000000, sys.argv[3]
 ns = (epoch, epoch)
 skip = {os.path.join(src, "out"), os.path.join(src, ".git")}
-n = 0
+# AEGIS (patch 143, APK RED 44054782081 + r97 stale-res review): files a
+# patch writes must KEEP their fresh mtimes. Stamping them to the bank epoch
+# made banked res outputs (aapt2 resourcezip / R.txt -> R.java) look
+# up-to-date forever, so patched value-resources shipped stale (the 136
+# toolbar-shortcut and 140 autofill-row removals never appeared in r97).
+# ninja -t deps cannot map res inputs (ACTION edges) and the gen: names are
+# template-dependent, so the fix belongs here: patched files stay newer than
+# the bank and ninja rebuilds their actions naturally.
+patched = set()
+if patch_dir and os.path.isdir(patch_dir):
+    for p in glob.glob(os.path.join(patch_dir, "*.patch")):
+        with open(p, errors="replace") as fh:
+            for ln in fh:
+                if ln.startswith("+++ ") and not ln.startswith("+++ /dev/null"):
+                    tok = ln[4:].split("	")[0].strip()
+                    if tok.startswith("b/"):
+                        tok = tok[2:]
+                    if tok:
+                        patched.add(os.path.join(src, tok))
+n = skipped = 0
 for root, dirs, files in os.walk(src):
     dirs[:] = [d for d in dirs if os.path.join(root, d) not in skip]
     for f in files:
+        fp = os.path.join(root, f)
+        if fp in patched:
+            skipped += 1
+            continue
         try:
-            os.utime(os.path.join(root, f), ns=ns, follow_symlinks=False)
+            os.utime(fp, ns=ns, follow_symlinks=False)
             n += 1
         except OSError:
             pass
-print(f"[restamp] stamped {n} source files @{src}")
+print(f"[restamp] stamped {n} source files @{src} "
+      f"(kept fresh mtimes for {skipped} patched files)")
 STAMPEOF
 }
 if ! stamp_tree 2>/dev/null; then

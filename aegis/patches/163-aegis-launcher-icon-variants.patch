@@ -0,0 +1,64 @@
+// Copyright 2026 The Aegis Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.aegis;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.pm.PackageManager;
+
+import org.chromium.build.annotations.NullMarked;
+
+/**
+ * Launcher icon variants (patch 163, r116 review: black default, white
+ * background, liquid glass). Implemented with activity-aliases: exactly
+ * one launcher identity is enabled at a time, switched with
+ * PackageManager.setComponentEnabledSetting - the mechanism launcher
+ * icon-pack apps use, no restart needed.
+ */
+@NullMarked
+public final class AegisLauncherIcon {
+    private static final String PREF = "aegis_launcher_icon";
+    /** The stock launcher alias from the Chromium manifest. */
+    private static final String MAIN_ALIAS = "com.google.android.apps.chrome.Main";
+    private static final String WHITE_ALIAS = "com.aegis.launcher.White";
+    private static final String GLASS_ALIAS = "com.aegis.launcher.Glass";
+
+    /** Display names for the chooser, indexed with the variant ids. */
+    public static final String[] VARIANTS = {"black", "white", "glass"};
+    public static final String[] LABELS = {"Black (default)", "White", "Liquid glass"};
+
+    private AegisLauncherIcon() {}
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences("aegis_prefs", Context.MODE_PRIVATE);
+    }
+
+    /** The persisted variant id; "black" until the user changes it. */
+    public static String current(Context context) {
+        return prefs(context).getString(PREF, "black");
+    }
+
+    /** Persists {@code variant} and flips the aliases (DONT_KILL_APP). */
+    public static void apply(Context context, String variant) {
+        prefs(context).edit().putString(PREF, variant).apply();
+        setAlias(context, MAIN_ALIAS, "black".equals(variant));
+        setAlias(context, WHITE_ALIAS, "white".equals(variant));
+        setAlias(context, GLASS_ALIAS, "glass".equals(variant));
+    }
+
+    private static void setAlias(Context context, String alias, boolean enabled) {
+        try {
+            PackageManager pm = context.getPackageManager();
+            pm.setComponentEnabledSetting(
+                    new ComponentName(context, alias),
+                    enabled ? PackageManager.COMPONENT_ENABLED_STATE_ENABLED
+                            : PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
+                    PackageManager.DONT_KILL_APP);
+        } catch (RuntimeException aliasError) {
+            // The launcher keeps the previous icon; never crash settings.
+        }
+    }
+}

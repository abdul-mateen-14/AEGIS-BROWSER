+
+    /**
+     * AEGIS (patch 163, r116 review: "allow users to change icon app
+     * launcher like with white background and the default black
+     * background and also the liquid glass one"): a single-choice dialog
+     * over the three variants; AegisLauncherIcon flips the aliases.
+     */
+    private void setupAegisAppIconPreference() {
+        Preference appIcon = findPreference("aegis_app_icon");
+        if (appIcon == null || getContext() == null) return;
+        appIcon.setOnPreferenceClickListener(preference -> {
+            Context context = getContext() != null ? getContext() : getActivity();
+            if (context == null) return true;
+            String current = AegisLauncherIcon.current(context);
+            int checked = "white".equals(current) ? 1 : ("glass".equals(current) ? 2 : 0);
+            new android.app.AlertDialog.Builder(context)
+                    .setTitle("App icon")
+                    .setSingleChoiceItems(
+                            AegisLauncherIcon.LABELS, checked,
+                            (dialog, which) -> {
+                                AegisLauncherIcon.apply(
+                                        context, AegisLauncherIcon.VARIANTS[which]);
+                                preference.setSummary(
+                                        "Black (default) · White · Liquid glass - now: "
+                                        + AegisLauncherIcon.LABELS[which]);
+                                dialog.dismiss();
+                            })
+                    .setNegativeButton("Cancel", null)
+                    .show();
+            return true;
+        });
+    }
+
 

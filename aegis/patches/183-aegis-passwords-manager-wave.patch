+                b.getUrl().getHost()));
+        if (creds.isEmpty()) {
+            addRow(list, "No saved passwords",
+                    "Passwords you save while browsing appear here", null);
+            return;
+        }
+        for (PasswordStoreCredential cred : creds) {
+            String host = cred.getUrl().getHost();
+            Preference row = addRow(list, host.isEmpty() ? cred.getUrl().getSpec() : host,
+                    cred.getUsername(), null);
+            row.setOnPreferenceClickListener(preference -> {

+                out.write(iv.length >> 24);
+                out.write(iv.length >> 16);
+                out.write(iv.length >> 8);
+                out.write(iv.length);
+                out.write(iv);
+                out.write(ct);
+            }
+        }
+        try (FileInputStream in = new FileInputStream(wrapped)) {
+            int ivLen = (in.read() << 24) | (in.read() << 16) | (in.read() << 8) | in.read();
+            byte[] iv = new byte[ivLen];
+            if (in.read(iv) != ivLen) throw new IllegalStateException("bad wrap file");
+            byte[] ct = new byte[(int) (wrapped.length() - 4 - ivLen)];
+            if (in.read(ct) != ct.length) throw new IllegalStateException("bad wrap file");
+            Cipher c = Cipher.getInstance("AES/GCM/NoPadding");
+            c.init(Cipher.DECRYPT_MODE, wrapKey, new GCMParameterSpec(GCM_TAG_BITS, iv));
+            return new SecretKeySpec(c.doFinal(ct), "AES");
+        }
+    }
+
+    private JSONArray readVault() throws Exception {
+        File file = new File(mContext.getFilesDir(), VAULT_FILE);
+        if (!file.exists()) return new JSONArray();
+        try (FileInputStream in = new FileInputStream(file)) {
+            int ivLen = (in.read() << 24) | (in.read() << 16) | (in.read() << 8) | in.read();
+            byte[] iv = new byte[ivLen];
+            if (in.read(iv) != ivLen) throw new IllegalStateException("bad vault file");
+            byte[] ct = new byte[(int) (file.length() - 4 - ivLen)];
+            if (in.read(ct) != ct.length) throw new IllegalStateException("bad vault file");
+            Cipher dc = Cipher.getInstance("AES/GCM/NoPadding");
+            dc.init(Cipher.DECRYPT_MODE, dataKey(),
+                    new GCMParameterSpec(GCM_TAG_BITS, iv));
+            byte[] plain = dc.doFinal(ct);
+            return new JSONArray(new String(plain, StandardCharsets.UTF_8));
+        }
+    }
+
+    private void writeVault(JSONArray arr) throws Exception {
+        File file = new File(mContext.getFilesDir(), VAULT_FILE);
+        Cipher c = Cipher.getInstance("AES/GCM/NoPadding");
+        c.init(Cipher.ENCRYPT_MODE, dataKey());
+        byte[] iv = c.getIV();
+        byte[] ct = c.doFinal(arr.toString().getBytes(StandardCharsets.UTF_8));
+        try (FileOutputStream out = new FileOutputStream(file)) {
+            out.write(iv.length >> 24);
+            out.write(iv.length >> 16);
+            out.write(iv.length >> 8);
+            out.write(iv.length);
+            out.write(iv);
+            out.write(ct);
+        }
+    }
+}

+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+
+namespace aegis {
+
+namespace {
+
+constexpr char kBase[] = "https://aegis-sync.abdulmateen14.workers.dev";
+constexpr size_t kMaxResponseBytes = 1 << 20;  // devices lists only
+constexpr base::TimeDelta kRequestTimeout = base::Seconds(15);
+
+constexpr net::NetworkTrafficAnnotationTag kAegisSyncAnnotation =
+    net::DefineNetworkTrafficAnnotation("aegis_id_client", R"(
+      semantics {
+        sender: "Aegis ID sign-in"
+        description:
+          "Signs the browser profile in to an Aegis ID account on the "
+          "aegis-sync service. Sends the account email, a PBKDF2-derived "
+          "verifier (never the password), device metadata and opaque "
+          "end-to-end-encrypted sync blobs. Replaces the Google/GAIA "
+          "sign-in flow in de-googled Aegis builds."
+        trigger:
+          "User clicks the Aegis ID sign-in button in the profile menu, or "
+          "opens an Aegis ID surface."
+        data:
+          "Email, verifier, KDF salt parameters, device uuid/name/platform, "
+          "access/refresh tokens, and end-to-end-encrypted sync items. The "
+          "master password and vault key never leave the device."
+        destination: OTHER
+        destination_other: "The operator-provided aegis-sync service host"
+      }
+      policy {
+        cookies_allowed: NO
+        setting:
+          "Not enabled unless the user signs in to an Aegis ID account."
+        policy_exception_justification:
+          "Not implemented; the request only happens on explicit user "
+          "sign-in."
+      }
+    )");
+
+constexpr int kHttpOk = 200;
+constexpr int kHttpCreated = 201;
+constexpr int kHttpUnauthorized = 401;
+constexpr int kHttpConflict = 409;
+
+std::string JsonEncode(const base::DictValue& dict) {
+  std::string out;
+  base::JSONWriter::Write(dict, &out);
+  return out;
+}
+
+std::string Str(const std::string* s) {
+  return s ? *s : std::string();
+}
+
+std::optional<base::DictValue> JsonDecodeDict(const std::string& body) {
+  if (body.empty()) {
+    return base::DictValue();
+  }
+  return base::JSONReader::ReadDict(body, base::JSON_PARSE_RFC);
+}
+
+AegisApiError DecodeApiError(int status, const base::DictValue* dict) {
+  AegisApiError error;
+  error.status = status;
+  if (dict) {
+    const base::DictValue* err = dict->FindDict("error");
+    if (err) {
+      if (const std::string* code = err->FindString("code")) {
+        error.code = *code;
+      }
+      if (const std::string* message = err->FindString("message")) {
+        error.message = *message;
+      }
+    }
+  }
+  return error;
+}
+
+#if BUILDFLAG(IS_WIN)
+constexpr char kPlatform[] = "windows";
+#elif BUILDFLAG(IS_LINUX)
+constexpr char kPlatform[] = "linux";
+#elif BUILDFLAG(IS_MAC)
+constexpr char kPlatform[] = "mac";
+#else
+constexpr char kPlatform[] = "desktop";
+#endif
+
+}  // namespace
+
+// The KDF chain result passed between the UI-thread network steps; the
+// master key is intentionally not kept. |algo|/|iterations| record the
+// params the credentials were derived with (the login reply may carry
+// migrated params; see OnLoginReply).
+struct AegisIdManager::Credentials {
+  std::vector<uint8_t> verifier;
+  std::vector<uint8_t> kek;
+  std::string algo;
+  int iterations = 0;
+};
+
+AegisIdManager::AegisIdManager(Profile* profile)
+    : profile_(profile),
+      state_path_(profile->GetPath().AppendASCII("aegis_id_state.json")),
+      loader_factory_(profile->GetDefaultStoragePartition()
+                          ->GetURLLoaderFactoryForBrowserProcess()) {}
+
+AegisIdManager::~AegisIdManager() = default;
+
+// ---------------------------------------------------------------- init
+
+void AegisIdManager::Init(base::OnceClosure on_ready) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath path) -> std::optional<base::DictValue> {
+            std::string content;
+            if (!base::ReadFileToString(path, &content)) {
+              return std::nullopt;
+            }
+            return base::JSONReader::ReadDict(content, base::JSON_PARSE_RFC);
+          },
+          state_path_),
+      base::BindOnce(&AegisIdManager::OnStateLoaded,
+                     weak_factory_.GetWeakPtr(), std::move(on_ready)));
+}
+
+void AegisIdManager::OnStateLoaded(base::OnceClosure on_ready,
+                                   std::optional<base::DictValue> state) {
+  if (state) {
+    signed_in_ = state->FindBool("signed_in").value_or(false);
+    email_ = base::UTF8ToUTF16(Str(state->FindString("email")));
+    device_uuid_ = Str(state->FindString("device_uuid"));
+  }
+  if (device_uuid_.empty()) {
+    device_uuid_ = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    PersistState();
+  }
+  ready_ = true;
+  std::move(on_ready).Run();
+}
+
+void AegisIdManager::PersistState() {
+  base::DictValue state;
+  state.Set("signed_in", signed_in_);
+  state.Set("email", base::UTF16ToUTF8(email_));
+  state.Set("device_uuid", device_uuid_);
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath path, std::string content) {
+            base::ImportantFileWriter::WriteFileAtomically(path, content);
+          },
+          state_path_, JsonEncode(state)));
+}
+
+// ------------------------------------------------------------- plumbing
+
+void AegisIdManager::FetchJson(
+    const GURL& url,
+    const std::string& method,
+    std::optional<std::string> body,
+    bool auth,
+    base::OnceCallback<void(int, std::optional<base::DictValue>)>
+        callback) {
+  CHECK(!loader_) << "Aegis ID requests must be serialized";
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->method = method;
+  request->headers.SetHeader("Accept", "application/json");
+  if (body) {
+    request->headers.SetHeader("Content-Type", "application/json");
+  }
+  if (auth && !access_token_.empty()) {
+    request->headers.SetHeader("Authorization", "Bearer " + access_token_);
+  }
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                             kAegisSyncAnnotation);
+  loader_->SetTimeoutDuration(kRequestTimeout);
+  if (body) {
+    loader_->AttachStringForUpload(*body, "application/json");
+  }
+  loader_->DownloadToString(
+      loader_factory_.get(),
+      base::BindOnce(&AegisIdManager::OnLoadComplete,
+                     weak_factory_.GetWeakPtr(), std::move(callback)),
+      kMaxResponseBytes);
+}
+
+void AegisIdManager::AuthedFetch(
+    const GURL& url,
+    const std::string& method,
+    std::optional<std::string> body,
+    base::OnceCallback<void(int, std::optional<base::DictValue>)>
+        callback) {
+  // The request consumes a copy of |body|; the original is kept for the
+  // 401-refresh retry.
+  FetchJson(url, method, body, /*auth=*/true,
+            base::BindOnce(&AegisIdManager::MaybeRefreshAndRetry,
+                           weak_factory_.GetWeakPtr(), url, method,
+                           std::move(body), std::move(callback)));
+}
+
+void AegisIdManager::MaybeRefreshAndRetry(
+    const GURL& url,
+    const std::string& method,
+    std::optional<std::string> body,
+    base::OnceCallback<void(int, std::optional<base::DictValue>)> callback,
+    int status,
+    std::optional<base::DictValue> data) {
+  if (status != kHttpUnauthorized || refresh_token_.empty()) {
+    std::move(callback).Run(status, std::move(data));
+    return;
+  }
+  // Rotate the tokens, then retry once without refresh.
+  base::DictValue refresh_body;
+  refresh_body.Set("refresh_token", refresh_token_);
+  FetchJson(GURL(std::string(kBase) + "/v1/auth/refresh"), "POST",
+            JsonEncode(refresh_body), /*auth=*/false,
+            base::BindOnce(&AegisIdManager::OnRefreshReply,
+                           weak_factory_.GetWeakPtr(), url, method,
+                           std::move(body), std::move(callback)));
+}
+
+void AegisIdManager::OnRefreshReply(
+    const GURL& url,
+    const std::string& method,
+    std::optional<std::string> body,
+    base::OnceCallback<void(int, std::optional<base::DictValue>)> callback,
+    int status,
+    std::optional<base::DictValue> data) {
+  if (status != kHttpOk || !data) {
+    // The volatile session died with the browser process; force sign-in.
+    access_token_.clear();
+    refresh_token_.clear();
+    vault_key_.clear();
+    std::move(callback).Run(status, std::move(data));
+    return;
+  }
+  access_token_ = Str(data->FindString("access_token"));
+  refresh_token_ = Str(data->FindString("refresh_token"));
+  FetchJson(url, method, std::move(body), /*auth=*/true, std::move(callback));
+}
+
+void AegisIdManager::OnLoadComplete(
+    base::OnceCallback<void(int, std::optional<base::DictValue>)> callback,
+    std::optional<std::string> body) {
+  std::unique_ptr<network::SimpleURLLoader> loader = std::move(loader_);
+  loader_.reset();
+
+  int status = 0;
+  if (loader->NetError() == net::OK && loader->ResponseInfo() &&
+      loader->ResponseInfo()->headers) {
+    status = loader->ResponseInfo()->headers->response_code();
+  }
+  std::optional<base::DictValue> dict;
+  if (status >= kHttpOk && body) {
+    dict = JsonDecodeDict(*body);
+  }
+  std::move(callback).Run(status, std::move(dict));
+}
+
+// ---------------------------------------------------------------- auth
+
+void AegisIdManager::SignIn(const std::u16string& email,
+                            const std::u16string& password,
+                            BoolCallback callback) {
+  DoSignIn(email, password, std::move(callback));
+}
+
+void AegisIdManager::DoSignIn(const std::u16string& email,
+                              const std::u16string& password,
+                              BoolCallback callback) {
+  const GURL url(base::StringPrintf(
+      "%s/v1/auth/kdf-params?email=%s", kBase,
+      base::EscapeQueryParamValue(base::UTF16ToUTF8(email), true).c_str()));
+  FetchJson(url, "GET", std::nullopt, /*auth=*/false,
+            base::BindOnce(&AegisIdManager::OnKdfParams,
+                           weak_factory_.GetWeakPtr(), email, password,
+                           std::move(callback)));
+}
+
+void AegisIdManager::OnKdfParams(const std::u16string& email,
+                                 const std::u16string& password,
+                                 BoolCallback callback,
+                                 int status,
+                                 std::optional<base::DictValue> data) {
+  if (status != kHttpOk || !data) {
+    std::move(callback).Run(
+        false,
+        DescribeError(status, DecodeApiError(status, data ? &*data : nullptr)));
+    return;
+  }
+  const std::string salt_b64 = Str(data->FindString("kdf_salt_b64"));
+  const base::DictValue* kdf = data->FindDict("kdf");
+  const std::string algo = kdf ? Str(kdf->FindString("algo")) : "";
+  const std::optional<int> iterations =
+      kdf ? kdf->FindInt("iterations") : std::nullopt;
+  if (salt_b64.empty() || algo != "PBKDF2-SHA256" || !iterations ||
+      *iterations < 1) {
+    std::move(callback).Run(
+        false, u"The sync service returned unsupported key parameters.");
+    return;
+  }
+  const std::string password_utf8 = base::UTF16ToUTF8(password);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](const std::string& password, const std::string& salt,
+             const std::string& algo,
+             int iterations) -> std::unique_ptr<Credentials> {
+            const aegis::Credentials derived =
+                DeriveCredentials(password, salt, iterations);
+            auto creds = std::make_unique<Credentials>();
+            creds->verifier = derived.verifier;
+            creds->kek = derived.kek;
+            creds->algo = algo;
+            creds->iterations = iterations;
+            return creds;
+          },
+          password_utf8, salt_b64, algo, *iterations),
+      base::BindOnce(&AegisIdManager::OnCredentialsDerived,
+                     weak_factory_.GetWeakPtr(), email, password,
+                     std::move(callback)));
+}
+
+void AegisIdManager::OnCredentialsDerived(
+    const std::u16string& email,
+    const std::u16string& password,
+    BoolCallback callback,
+    std::unique_ptr<Credentials> creds) {
+  base::DictValue device;
+  device.Set("id", device_uuid_);
+  device.Set("name", "Aegis Desktop");
+  device.Set("platform", kPlatform);
+  base::DictValue body;
+  body.Set("email", base::UTF16ToUTF8(email));
+  body.Set("verifier_b64", Base64Encode(creds->verifier));
+  body.Set("device", std::move(device));
+
+  FetchJson(GURL(std::string(kBase) + "/v1/auth/login"), "POST",
+            JsonEncode(body), /*auth=*/false,
+            base::BindOnce(&AegisIdManager::OnLoginReply,
+                           weak_factory_.GetWeakPtr(), email, password,
+                           std::move(creds), std::move(callback)));
+}
+
+void AegisIdManager::OnLoginReply(const std::u16string& email,
+                                  const std::u16string& password,
+                                  std::unique_ptr<Credentials> creds,
+                                  BoolCallback callback,
+                                  int status,
+                                  std::optional<base::DictValue> data) {
+  if (status != kHttpOk || !data) {
+    std::move(callback).Run(
+        false,
+        DescribeError(status, DecodeApiError(status, data ? &*data : nullptr)));
+    return;
+  }
+  access_token_ = Str(data->FindString("access_token"));
+  refresh_token_ = Str(data->FindString("refresh_token"));
+  base::DictValue* user = data->FindDict("user");
+  if (access_token_.empty() || refresh_token_.empty() || !user) {
+    std::move(callback).Run(false, u"The sync service sent a malformed reply.");
+    return;
+  }
+
+  // Unwrap the vault key on the pool, honoring migrated KDF params exactly
+  // like the Android client's unwrapVaultKey: if the account's CURRENT
+  // params (from the login reply) differ from the ones we derived with,
+  // re-derive the KEK once from the passphrase before unwrapping.
+  const std::string password_utf8 = base::UTF16ToUTF8(password);
+  base::DictValue user_copy = user->Clone();
+  // Copy the derived-with params before moving |creds| into the pool task
+  // (argument evaluation order is unspecified).
+  const std::string login_algo = creds->algo;
+  const int login_iterations = creds->iterations;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](const std::string& password, const std::string& login_algo,
+             int login_iterations, std::unique_ptr<Credentials> creds,
+             base::DictValue user) -> std::vector<uint8_t> {
+            const std::string user_salt =
+                Str(user.FindString("kdf_salt_b64"));
+            const base::DictValue* user_kdf = user.FindDict("kdf");
+            const std::string user_algo =
+                user_kdf ? Str(user_kdf->FindString("algo")) : "";
+            const std::optional<int> user_iterations =
+                user_kdf ? user_kdf->FindInt("iterations") : std::nullopt;
+            const std::string wrapped =
+                Str(user.FindString("wrapped_vault_key_b64"));
+            const std::string nonce =
+                Str(user.FindString("vault_nonce_b64"));
+            std::vector<uint8_t> wrapped_bytes, nonce_bytes;
+            if (user_salt.empty() || wrapped.empty() || nonce.empty() ||
+                !user_iterations || *user_iterations < 1 ||
+                !Base64Decode(wrapped, &wrapped_bytes) ||
+                !Base64Decode(nonce, &nonce_bytes)) {
+              return {};
+            }
+            Credentials local = std::move(*creds);
+            if (user_algo != login_algo ||
+                *user_iterations != login_iterations) {
+              local.kek = DeriveCredentials(password, user_salt,
+                                            *user_iterations)
+                              .kek;
+            }
+            std::optional<std::vector<uint8_t>> vault =
+                AesGcmOpen(local.kek, nonce_bytes, wrapped_bytes);
+            return vault.value_or(std::vector<uint8_t>{});
+          },
+          password_utf8, login_algo, login_iterations, std::move(creds),
+          std::move(user_copy)),
+      base::BindOnce(&AegisIdManager::OnVaultKeyUnwrapped,
+                     weak_factory_.GetWeakPtr(), email, std::move(callback)));
+}
+
+void AegisIdManager::OnVaultKeyUnwrapped(const std::u16string& email,
+                                         BoolCallback callback,
+                                         std::vector<uint8_t> vault_key) {
+  if (vault_key.size() != kVaultKeySize) {
+    // Tokens arrived but the vault could not be opened: treat as failure so
+    // the user is not left in a half-signed-in state.
+    std::move(callback).Run(false, u"Couldn't open your encrypted vault.");
+    return;
+  }
+  vault_key_ = std::move(vault_key);
+  signed_in_ = true;
+  email_ = email;
+  PersistState();
+  std::move(callback).Run(true, email);
+}
+
+void AegisIdManager::CreateAccount(const std::u16string& email,
+                                   const std::u16string& password,
+                                   BoolCallback callback) {
+  const std::string email_utf8 = base::UTF16ToUTF8(email);
+  const std::string password_utf8 = base::UTF16ToUTF8(password);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](const std::string& email,
+             const std::string& password) -> std::string {
+            const std::string salt_b64 =
+                Base64Encode(RandomBytes(kKdfSaltSize));
+            const aegis::Credentials creds =
+                DeriveCredentials(password, salt_b64, kDefaultIterations);
+            const std::vector<uint8_t> vault_key = RandomBytes(kVaultKeySize);
+            auto [nonce, wrapped] = AesGcmSeal(creds.kek, vault_key);
+            base::DictValue kdf;
+            kdf.Set("algo", "PBKDF2-SHA256");
+            kdf.Set("iterations", static_cast<int>(kDefaultIterations));
+            base::DictValue body;
+            body.Set("email", email);
+            body.Set("kdf_salt_b64", salt_b64);
+            body.Set("kdf", std::move(kdf));
+            body.Set("verifier_b64", Base64Encode(creds.verifier));
+            body.Set("wrapped_vault_key_b64", Base64Encode(wrapped));
+            body.Set("vault_nonce_b64", Base64Encode(nonce));
+            return JsonEncode(body);
+          },
+          email_utf8, password_utf8),
+      base::BindOnce(&AegisIdManager::OnRegisterBodyReady,
+                     weak_factory_.GetWeakPtr(), email, password,
+                     std::move(callback)));
+}
+
+void AegisIdManager::OnRegisterBodyReady(const std::u16string& email,
+                                         const std::u16string& password,
+                                         BoolCallback callback,
+                                         std::string body) {
+  FetchJson(GURL(std::string(kBase) + "/v1/auth/register"), "POST", body,
+            /*auth=*/false,
+            base::BindOnce(&AegisIdManager::OnRegisterReply,
+                           weak_factory_.GetWeakPtr(), email, password,
+                           std::move(callback)));
+}
+
+void AegisIdManager::OnRegisterReply(const std::u16string& email,
+                                     const std::u16string& password,
+                                     BoolCallback callback,
+                                     int status,
+                                     std::optional<base::DictValue> data) {
+  if (status != kHttpCreated && status != kHttpOk) {
+    std::move(callback).Run(
+        false,
+        DescribeError(status, DecodeApiError(status, data ? &*data : nullptr)));
+    return;
+  }
+  // Registration succeeded; run the normal sign-in flow.
+  DoSignIn(email, password, std::move(callback));
+}
+
+// ------------------------------------------------------- sign-out, devices
+
+void AegisIdManager::SignOut(BoolCallback callback) {
+  if (access_token_.empty() && refresh_token_.empty()) {
+    OnSignOutReply(std::move(callback), 0, std::nullopt);
+    return;
+  }
+  AuthedFetch(GURL(std::string(kBase) + "/v1/auth/logout"), "POST",
+              std::nullopt,
+              base::BindOnce(&AegisIdManager::OnSignOutReply,
+                             weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void AegisIdManager::OnSignOutReply(BoolCallback callback,
+                                    int status,
+                                    std::optional<base::DictValue> data) {
+  // Best effort: the server session also expires on its own.
+  access_token_.clear();
+  refresh_token_.clear();
+  vault_key_.clear();
+  signed_in_ = false;
+  email_.clear();
+  PersistState();
+  std::move(callback).Run(true, u"");
+}
+
+void AegisIdManager::ListDevices(DevicesCallback callback) {
+  if (access_token_.empty() && refresh_token_.empty()) {
+    std::move(callback).Run(false, {}, u"Your session expired. Sign in again.");
+    return;
+  }
+  AuthedFetch(GURL(std::string(kBase) + "/v1/devices"), "GET", std::nullopt,
+              base::BindOnce(&AegisIdManager::OnDevicesReply,
+                             weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void AegisIdManager::OnDevicesReply(DevicesCallback callback,
+                                    int status,
+                                    std::optional<base::DictValue> data) {
+  if (status != kHttpOk || !data) {
+    std::move(callback).Run(
+        false, {},
+        DescribeError(status, DecodeApiError(status, data ? &*data : nullptr)));
+    return;
+  }
+  std::vector<AegisDeviceInfo> devices;
+  const base::ListValue* list = data->FindList("devices");
+  if (list) {
+    for (const base::Value& entry : *list) {
+      const base::DictValue& d = entry.GetDict();
+      AegisDeviceInfo info;
+      info.id = Str(d.FindString("id"));
+      info.name = Str(d.FindString("name"));
+      info.platform = Str(d.FindString("platform"));
+      info.created_at = static_cast<int64_t>(d.FindDouble("created_at").value_or(0));
+      info.last_seen_at = static_cast<int64_t>(d.FindDouble("last_seen_at").value_or(0));
+      info.current = d.FindBool("current").value_or(false);
+      if (!info.id.empty()) {
+        devices.push_back(std::move(info));
+      }
+    }
+  }
+  std::move(callback).Run(true, std::move(devices), u"");
+}
+
+// ---------------------------------------------------------------- errors
+
+std::u16string AegisIdManager::DescribeError(int status,
+                                             const AegisApiError& error) {
+  if (status == 0) {
+    return u"Couldn't reach the Aegis sync service. Check your connection "
+           u"and try again.";
+  }
+  if (status == kHttpUnauthorized &&
+      (error.code == "invalid_credentials" || error.code.empty())) {
+    return u"Incorrect email or password.";
+  }
+  if (status == kHttpUnauthorized) {
+    return u"Your session expired. Sign in again.";
+  }
+  if (status == kHttpConflict) {
+    return u"An account with this email already exists.";
+  }
+  if (!error.message.empty()) {
+    return base::UTF8ToUTF16(error.message);
+  }
+  return base::UTF8ToUTF16(
+      base::StringPrintf("The sync service returned an error (HTTP %d).",
+                         status));
+}
+
+}  // namespace aegis


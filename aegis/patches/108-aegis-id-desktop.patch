# 108 - aegis-id-desktop
# Desktop Aegis ID: a real aegis-sync account surface replacing the
# profile menu's Google/GAIA sign-in flow in de-googled Aegis builds.
#
# - aegis_id_crypto: byte-exact C++ port of the client crypto (PBKDF2 over
#   raw-byte passwords via crypto::hmac, HKDF via crypto::kdf, AES-256-GCM
#   via crypto::aead), cross-validated against aegis-client.mjs and the
#   Android AegisCrypto.java and against the LIVE worker end to end.
# - aegis_id_manager: profile-keyed auth client (register/login/refresh/
#   devices/logout) over SimpleURLLoader; state in
#   aegis_id_state.json (signed_in + email + device uuid); tokens and the
#   vault key stay volatile exactly like the Android client.
# - aegis_id_dialog: the sign-in/account dialog (views).
# - dialog_delegate.h: DialogDelegateView passkey - AegisIdSignInDialog is
#   added to the grandfathered friend list (156 made the default ctor
#   private).
# - profile_menu_view: the "Sign in to Aegis?" promo button opens the Aegis
#   ID dialog instead of signin_ui_util::EnableSyncFromSingleAccountPromo.
#
# The new source_set is scoped to is_win/is_mac/is_linux so android builds
# never see it; profile_menu_view.cc already is desktop-only.


diff --git a/chrome/browser/ui/views/profiles/aegis_id_crypto.h b/chrome/browser/ui/views/profiles/aegis_id_crypto.h
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/views/profiles/aegis_id_crypto.h
@@ -0,0 +1,94 @@
+// Copyright 2026 The Aegis Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_PROFILES_AEGIS_ID_CRYPTO_H_
+#define CHROME_BROWSER_UI_VIEWS_PROFILES_AEGIS_ID_CRYPTO_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/containers/span.h"
+
+namespace aegis {
+
+// Client-side crypto for Aegis ID (the aegis-sync account system). This is a
+// byte-exact C++ port of the reference implementations the project already
+// ships and cross-validates: aegis-sync/client-example/aegis-client.mjs
+// (WebCrypto) and the Android client's AegisCrypto.java. All three implement
+// the v1 spec documented in aegis-sync/README.md section 5:
+//
+//   masterKey = PBKDF2-SHA256(utf8(password), kdf_salt, 600000)   [32 B]
+//   authKey   = HKDF-SHA256(masterKey, info="aegis-auth-v1")      [32 B]
+//   verifier  = PBKDF2-SHA256(authKey, "aegis-verifier-v1", 1e5)  [32 B, TLS only]
+//   kek       = HKDF-SHA256(masterKey, info="aegis-kek-v1")       [32 B]
+//   wrapped   = AES-256-GCM(kek, vaultKey)                        [stored on server]
+//
+// WHY HAND-ROLLED PBKDF2 (12 lines over crypto::hmac) instead of
+// crypto::kdf::Pbkdf2HmacSha1: the protocol needs HMAC-SHA256 and, more
+// importantly, the WebCrypto convention that the PASSWORD IS RAW BYTES -
+// KDF wrappers that take std::string keys would re-encode non-ASCII
+// passwords differently across platforms and break cross-device logins.
+// The Android client hand-rolls for the identical reason (documented in
+// AegisCrypto.java); both are validated against the same generated test
+// vectors in android-sync/test/ and aegis-sync/test/.
+
+inline constexpr uint32_t kDefaultIterations = 600000;
+inline constexpr uint32_t kVerifierIterations = 100000;
+inline constexpr size_t kVaultKeySize = 32;
+inline constexpr size_t kKdfSaltSize = 16;
+inline constexpr size_t kGcmNonceSize = 12;
+
+struct Credentials {
+  std::vector<uint8_t> verifier;  // sent to the server at login only
+  std::vector<uint8_t> kek;       // wraps/unwraps the vault key, never sent
+};
+
+// RFC 2898 PBKDF2-HMAC-SHA256 with a RAW-BYTE password (WebCrypto
+// semantics). Returns dk_len bytes.
+std::vector<uint8_t> Pbkdf2Sha256(base::span<const uint8_t> password,
+                                  base::span<const uint8_t> salt,
+                                  uint32_t iterations,
+                                  size_t dk_len);
+
+// RFC 5869 HKDF-SHA256 extract+expand with the reference implementation's
+// zero-filled 32-byte salt, producing `length` bytes. An empty salt and a
+// zero-filled salt are byte-equivalent (HMAC zero-pads keys), which is why
+// the JS reference's `salt: null` and the Java port's new byte[32] agree.
+std::vector<uint8_t> HkdfSha256(base::span<const uint8_t> ikm,
+                                base::span<const uint8_t> info,
+                                size_t length);
+
+// The full login preflight chain: master key -> auth key -> verifier, plus
+// the KEK. `kdf_salt_b64` is the padded-Base64 salt returned by
+// GET /v1/auth/kdf-params (or generated at registration).
+Credentials DeriveCredentials(const std::string& password,
+                              const std::string& kdf_salt_b64,
+                              uint32_t iterations);
+
+// AES-256-GCM with an empty AAD and a 12-byte nonce, matching the WebCrypto
+// default used by the reference clients. Seal returns {nonce, ct||tag};
+// Open returns nullopt for a wrong key/tampered ciphertext.
+std::pair<std::vector<uint8_t>, std::vector<uint8_t>> AesGcmSeal(
+    base::span<const uint8_t> key,
+    base::span<const uint8_t> plaintext);
+std::optional<std::vector<uint8_t>> AesGcmOpen(
+    base::span<const uint8_t> key,
+    base::span<const uint8_t> nonce,
+    base::span<const uint8_t> ciphertext);
+
+std::vector<uint8_t> RandomBytes(size_t n);
+
+// Standard padded Base64 (same alphabet as JS btoa/atob and Java
+// Base64.getEncoder()). Decode returns false on any padding/alphabet error.
+std::string Base64Encode(base::span<const uint8_t> bytes);
+bool Base64Decode(std::string_view text, std::vector<uint8_t>* out);
+
+}  // namespace aegis
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PROFILES_AEGIS_ID_CRYPTO_H_

diff --git a/chrome/browser/ui/views/profiles/aegis_id_crypto.cc b/chrome/browser/ui/views/profiles/aegis_id_crypto.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/views/profiles/aegis_id_crypto.cc
@@ -0,0 +1,129 @@
+// Copyright 2026 The Aegis Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/profiles/aegis_id_crypto.h"
+
+#include <algorithm>
+#include <array>
+
+#include "base/base64.h"
+#include "base/check.h"
+#include "base/containers/span.h"
+#include "crypto/aead.h"
+#include "crypto/hash.h"
+#include "crypto/hmac.h"
+#include "crypto/kdf.h"
+#include "crypto/random.h"
+
+namespace aegis {
+
+namespace {
+
+base::span<const uint8_t> InfoSpan(std::string_view s) {
+  return base::span<const uint8_t>(
+      reinterpret_cast<const uint8_t*>(s.data()), s.size());
+}
+
+}  // namespace
+
+std::vector<uint8_t> Pbkdf2Sha256(base::span<const uint8_t> password,
+                                  base::span<const uint8_t> salt,
+                                  uint32_t iterations,
+                                  size_t dk_len) {
+  CHECK_GT(iterations, 0u);
+  CHECK_GT(dk_len, 0u);
+  std::vector<uint8_t> out(dk_len, 0);
+  size_t copied = 0;
+  uint32_t block = 1;
+  while (copied < dk_len) {
+    // U1 = PRF(P, S || INT_32_BE(block))
+    std::vector<uint8_t> salt_block(salt.begin(), salt.end());
+    salt_block.push_back((block >> 24) & 0xFF);
+    salt_block.push_back((block >> 16) & 0xFF);
+    salt_block.push_back((block >> 8) & 0xFF);
+    salt_block.push_back(block & 0xFF);
+    std::array<uint8_t, 32> u = crypto::hmac::SignSha256(password, salt_block);
+    std::array<uint8_t, 32> t = u;
+    for (uint32_t i = 2; i <= iterations; ++i) {
+      u = crypto::hmac::SignSha256(password, u);
+      for (size_t j = 0; j < t.size(); ++j) {
+        t[j] ^= u[j];
+      }
+    }
+    const size_t n = std::min<size_t>(t.size(), dk_len - copied);
+    for (size_t i = 0; i < n; ++i) {
+      out[copied + i] = t[i];
+    }
+    copied += n;
+    ++block;
+  }
+  return out;
+}
+
+std::vector<uint8_t> HkdfSha256(base::span<const uint8_t> ikm,
+                                base::span<const uint8_t> info,
+                                size_t length) {
+  // Zero-filled 32-byte salt, byte-equivalent to the JS reference's empty
+  // salt (HMAC zero-pads keys) - see the header comment.
+  static constexpr std::array<uint8_t, 32> kZeroSalt{};
+  std::vector<uint8_t> out(length);
+  crypto::kdf::Hkdf(crypto::hash::HashKind::kSha256, ikm, kZeroSalt, info,
+                    base::span<uint8_t>(out));
+  return out;
+}
+
+Credentials DeriveCredentials(const std::string& password,
+                              const std::string& kdf_salt_b64,
+                              uint32_t iterations) {
+  std::vector<uint8_t> salt;
+  CHECK(Base64Decode(kdf_salt_b64, &salt));
+  const std::vector<uint8_t> password_bytes(password.begin(), password.end());
+  const std::vector<uint8_t> master_key =
+      Pbkdf2Sha256(password_bytes, salt, iterations, 32);
+  Credentials creds;
+  const std::vector<uint8_t> auth_key =
+      HkdfSha256(master_key, InfoSpan("aegis-auth-v1"), 32);
+  creds.verifier = Pbkdf2Sha256(
+      auth_key, InfoSpan("aegis-verifier-v1"), kVerifierIterations, 32);
+  creds.kek = HkdfSha256(master_key, InfoSpan("aegis-kek-v1"), 32);
+  return creds;
+}
+
+std::pair<std::vector<uint8_t>, std::vector<uint8_t>> AesGcmSeal(
+    base::span<const uint8_t> key,
+    base::span<const uint8_t> plaintext) {
+  std::vector<uint8_t> nonce = crypto::RandBytesAsVector(kGcmNonceSize);
+  std::vector<uint8_t> ciphertext = crypto::aead::Seal(
+      crypto::aead::Algorithm::AES_256_GCM, key, plaintext, nonce,
+      /*associated_data=*/{});
+  CHECK(!ciphertext.empty());
+  return {std::move(nonce), std::move(ciphertext)};
+}
+
+std::optional<std::vector<uint8_t>> AesGcmOpen(
+    base::span<const uint8_t> key,
+    base::span<const uint8_t> nonce,
+    base::span<const uint8_t> ciphertext) {
+  return crypto::aead::Open(crypto::aead::Algorithm::AES_256_GCM, key,
+                            ciphertext, nonce, /*associated_data=*/{});
+}
+
+std::vector<uint8_t> RandomBytes(size_t n) {
+  return crypto::RandBytesAsVector(n);
+}
+
+std::string Base64Encode(base::span<const uint8_t> bytes) {
+  return base::Base64Encode(bytes);
+}
+
+bool Base64Decode(std::string_view text, std::vector<uint8_t>* out) {
+  std::optional<std::vector<uint8_t>> decoded = base::Base64Decode(text);
+  if (!decoded) {
+    return false;
+  }
+  *out = std::move(*decoded);
+  return true;
+}
+
+}  // namespace aegis

diff --git a/chrome/browser/ui/views/profiles/aegis_id_manager.h b/chrome/browser/ui/views/profiles/aegis_id_manager.h
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/views/profiles/aegis_id_manager.h
@@ -0,0 +1,215 @@
+// Copyright 2026 The Aegis Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_PROFILES_AEGIS_ID_MANAGER_H_
+#define CHROME_BROWSER_UI_VIEWS_PROFILES_AEGIS_ID_MANAGER_H_
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "url/gurl.h"
+
+class Profile;
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+namespace aegis {
+
+// One row of GET /v1/devices.
+struct AegisDeviceInfo {
+  std::string id;
+  std::string name;
+  std::string platform;
+  int64_t created_at = 0;
+  int64_t last_seen_at = 0;
+  bool current = false;
+};
+
+// A non-2xx reply, decoded exactly like AegisSyncClient.java does:
+// {"error": {"code": "...", "message": "..."}}.
+struct AegisApiError {
+  int status = 0;
+  std::string code;     // e.g. "invalid_credentials"; may be empty
+  std::string message;  // raw server message; may be empty
+};
+
+// Desktop Aegis ID client: account state + authentication + device
+// management against the aegis-sync worker (see aegis-sync/README.md).
+// C++ port of the Android AegisIdManager/AegisSyncClient pair, cross-checked
+// against a live end-to-end protocol run (register -> kdf-params -> login ->
+// vault-key unwrap -> devices -> logout).
+//
+// Threading model: all entry points are called on the UI thread (the dialog
+// owns this object). The 600k-iteration KDF chain and the state-file IO run
+// on a ThreadPool sequence; network requests run on the UI thread through a
+// SimpleURLLoader created from the browser-process factory. Requests are
+// serialized (one in-flight SimpleURLLoader); the dialog disables its
+// buttons while an operation runs.
+//
+// Persistence (aegis_id_state.json in the profile dir, mirroring the
+// Android client's prefs): signed_in + email + device uuid. Session tokens
+// and the vault key stay volatile like on Android - after a browser restart
+// the dialog shows the "session expired" state until the user signs in
+// again. Persisting the refresh token would fix that, but it would put a
+// usable credential into the profile file, which the Android client
+// deliberately does not do either.
+class AegisIdManager {
+ public:
+  // ok=true: |message| carries the signed-in email; ok=false: |message| is
+  // a user-presentable error.
+  using BoolCallback =
+      base::OnceCallback<void(bool ok, const std::u16string& message)>;
+  using DevicesCallback = base::OnceCallback<void(
+      bool ok, std::vector<AegisDeviceInfo>, const std::u16string& message)>;
+
+  // |profile| must outlive the manager (the owning dialog observes profile
+  // destruction and closes first).
+  explicit AegisIdManager(Profile* profile);
+  ~AegisIdManager();
+
+  AegisIdManager(const AegisIdManager&) = delete;
+  AegisIdManager& operator=(const AegisIdManager&) = delete;
+
+  // Loads the persisted state; |on_ready| runs on the UI thread once
+  // signed_in()/email() are trustworthy.
+  void Init(base::OnceClosure on_ready);
+
+  bool ready() const { return ready_; }
+  bool signed_in() const { return signed_in_; }
+  bool session_live() const {
+    return !access_token_.empty() || !refresh_token_.empty();
+  }
+  const std::u16string& email() const { return email_; }
+  const std::string& device_uuid() const { return device_uuid_; }
+
+  void SignIn(const std::u16string& email,
+              const std::u16string& password,
+              BoolCallback callback);
+  void CreateAccount(const std::u16string& email,
+                     const std::u16string& password,
+                     BoolCallback callback);
+  // Best-effort server logout; always succeeds locally.
+  void SignOut(BoolCallback callback);
+  void ListDevices(DevicesCallback callback);
+
+ private:
+  struct Credentials;
+
+  // --- init / persistence ---
+  void OnStateLoaded(base::OnceClosure on_ready,
+                     std::optional<base::DictValue> state);
+  void PersistState();
+
+  // --- network plumbing (UI thread) ---
+  void FetchJson(const GURL& url,
+                 const std::string& method,
+                 std::optional<std::string> body,
+                 bool auth,
+                 base::OnceCallback<void(int, std::optional<base::DictValue>)>
+                     callback);
+  // Like FetchJson with auth=true, but transparently refreshes the tokens
+  // once on a 401 (mirrors AegisSyncClient's retry) and retries the request.
+  void AuthedFetch(const GURL& url,
+                   const std::string& method,
+                   std::optional<std::string> body,
+                   base::OnceCallback<void(int, std::optional<base::DictValue>)>
+                       callback);
+  void MaybeRefreshAndRetry(
+      const GURL& url,
+      const std::string& method,
+      std::optional<std::string> body,
+      base::OnceCallback<void(int, std::optional<base::DictValue>)> callback,
+      int status,
+      std::optional<base::DictValue> data);
+  void OnRefreshReply(
+      const GURL& url,
+      const std::string& method,
+      std::optional<std::string> body,
+      base::OnceCallback<void(int, std::optional<base::DictValue>)> callback,
+      int status,
+      std::optional<base::DictValue> data);
+  void OnLoadComplete(
+      base::OnceCallback<void(int, std::optional<base::DictValue>)> callback,
+      std::optional<std::string> body);
+
+  // --- sign-in chain ---
+  void DoSignIn(const std::u16string& email,
+                const std::u16string& password,
+                BoolCallback callback);
+  void OnKdfParams(const std::u16string& email,
+                   const std::u16string& password,
+                   BoolCallback callback,
+                   int status,
+                   std::optional<base::DictValue> data);
+  void OnCredentialsDerived(const std::u16string& email,
+                            const std::u16string& password,
+                            BoolCallback callback,
+                            std::unique_ptr<Credentials> creds);
+  void OnLoginReply(const std::u16string& email,
+                    const std::u16string& password,
+                    std::unique_ptr<Credentials> creds,
+                    BoolCallback callback,
+                    int status,
+                    std::optional<base::DictValue> data);
+  void OnVaultKeyUnwrapped(const std::u16string& email,
+                           BoolCallback callback,
+                           std::vector<uint8_t> vault_key);
+
+  // --- registration chain ---
+  void OnRegisterBodyReady(const std::u16string& email,
+                           const std::u16string& password,
+                           BoolCallback callback,
+                           std::string body);
+  void OnRegisterReply(const std::u16string& email,
+                       const std::u16string& password,
+                       BoolCallback callback,
+                       int status,
+                       std::optional<base::DictValue> data);
+
+  // --- sign-out / devices ---
+  void OnSignOutReply(BoolCallback callback,
+                      int status,
+                      std::optional<base::DictValue> data);
+  void OnDevicesReply(DevicesCallback callback,
+                      int status,
+                      std::optional<base::DictValue> data);
+
+  // User-presentable error for a failed request (mirrors the Android
+  // describeApiError mapping).
+  std::u16string DescribeError(int status, const AegisApiError& error);
+
+  raw_ptr<Profile> profile_;
+  base::FilePath state_path_;
+  scoped_refptr<network::SharedURLLoaderFactory> loader_factory_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+
+  // Volatile session (cleared when the browser exits).
+  std::string access_token_;
+  std::string refresh_token_;
+  std::vector<uint8_t> vault_key_;
+
+  // Persisted state.
+  bool ready_ = false;
+  bool signed_in_ = false;
+  std::u16string email_;
+  std::string device_uuid_;
+
+  base::WeakPtrFactory<AegisIdManager> weak_factory_{this};
+};
+
+}  // namespace aegis
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PROFILES_AEGIS_ID_MANAGER_H_


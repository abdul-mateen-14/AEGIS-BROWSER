+#include "ui/views/window/dialog_delegate.h"
+
+namespace aegis {
+
+namespace {
+
+constexpr char16_t kDialogTitle[] = u"Aegis ID";
+
+std::u16string FormatSeen(int64_t last_seen_at) {
+  if (last_seen_at <= 0) {
+    return u"";
+  }
+  const base::Time seen = base::Time::FromSecondsSinceUnixEpoch(last_seen_at);
+  const base::TimeDelta age = base::Time::Now() - seen;
+  if (age < base::Minutes(2)) {
+    return u"active now";
+  }
+  if (age < base::Hours(1)) {
+    return u"active in the last hour";
+  }
+  if (age < base::Hours(24)) {
+    return u"active in the last day";
+  }
+  return u"active in the last week";
+}
+
+}  // namespace
+
+// The widget owns the dialog view, the dialog owns the manager. Profile
+// destruction closes the dialog first (OnProfileWillBeDestroyed).
+//
+// Manager callbacks use base::Unretained(this): the manager is owned by the
+// dialog, so every manager reply runs only while the dialog is alive. The
+// dialog-closing paths (profile destruction) synchronously destroy the
+// manager, whose own replies are bound to the manager's WeakPtrFactory and
+// are therefore dropped.
+class AegisIdSignInDialog : public views::DialogDelegateView,
+                            public ProfileObserver {
+ public:
+  explicit AegisIdSignInDialog(Profile* profile);
+  ~AegisIdSignInDialog() override;
+
+  // views::DialogDelegate:
+  std::u16string GetWindowTitle() const override;
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+
+ private:
+  void BuildLayout();
+  void OnManagerReady();
+  void RefreshState();
+  void ShowForm();
+  void ShowAccount();
+  void SetBusy(bool busy);
+  void ShowError(const std::u16string& message);
+  void ClearError();
+
+  void OnSignInClicked();
+  void OnCreateClicked();
+  void OnSignOutClicked();
+  void OnSignInDone(bool ok, const std::u16string& message);
+  void OnDevicesFetched(bool ok,
+                        std::vector<AegisDeviceInfo> devices,
+                        const std::u16string& message);
+
+  raw_ptr<Profile> profile_ = nullptr;
+  std::unique_ptr<AegisIdManager> manager_;
+
+  // View children (owned by the view tree).
+  raw_ptr<views::Label> status_label_ = nullptr;
+  raw_ptr<views::Label> error_label_ = nullptr;
+  raw_ptr<views::View> form_container_ = nullptr;
+  raw_ptr<views::Textfield> email_field_ = nullptr;
+  raw_ptr<views::Textfield> password_field_ = nullptr;
+  raw_ptr<views::MdTextButton> signin_button_ = nullptr;
+  raw_ptr<views::MdTextButton> create_button_ = nullptr;
+  raw_ptr<views::View> account_container_ = nullptr;
+  raw_ptr<views::View> devices_container_ = nullptr;
+  raw_ptr<views::MdTextButton> signout_button_ = nullptr;
+};
+
+AegisIdSignInDialog::AegisIdSignInDialog(Profile* profile)
+    : profile_(profile) {
+  profile_->AddObserver(this);
+  // The form carries its own action buttons; no dialog chrome buttons.
+  SetButtons(0);
+  BuildLayout();
+
+  manager_ = std::make_unique<AegisIdManager>(profile);
+  manager_->Init(base::BindOnce(&AegisIdSignInDialog::OnManagerReady,
+                                base::Unretained(this)));
+}
+
+AegisIdSignInDialog::~AegisIdSignInDialog() {
+  if (profile_) {
+    profile_->RemoveObserver(this);
+  }
+}
+
+std::u16string AegisIdSignInDialog::GetWindowTitle() const {
+  return kDialogTitle;
+}
+
+void AegisIdSignInDialog::OnProfileWillBeDestroyed(Profile* profile) {
+  profile_ = nullptr;
+  if (GetWidget()) {
+    GetWidget()->CloseNow();
+  }
+}
+
+void AegisIdSignInDialog::BuildLayout() {
+  views::BoxLayout* layout =
+      SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(16, 24),
+          8));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kStart);
+
+  status_label_ = AddChildView(std::make_unique<views::Label>(
+      u"Not signed in", views::style::CONTEXT_DIALOG_BODY_TEXT,
+      views::style::STYLE_PRIMARY));
+  status_label_->SetMultiLine(true);
+  status_label_->SetPreferredSize(gfx::Size(360, 0));
+
+  error_label_ = AddChildView(std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_DIALOG_BODY_TEXT,
+      views::style::STYLE_INVALID));
+  error_label_->SetMultiLine(true);
+  error_label_->SetPreferredSize(gfx::Size(360, 0));
+  error_label_->SetVisible(false);
+
+  form_container_ = AddChildView(std::make_unique<views::View>());
+  form_container_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8));
+
+  auto email = std::make_unique<views::Textfield>();
+  email->SetPlaceholderText(u"you@example.com");
+  email->SetTextInputType(ui::TEXT_INPUT_TYPE_EMAIL);
+  email->SetAccessibleName(u"Email");
+  email->SetPreferredSize(gfx::Size(360, 0));
+  email_field_ = form_container_->AddChildView(std::move(email));
+
+  auto password = std::make_unique<views::Textfield>();
+  password->SetPlaceholderText(u"Master password");
+  password->SetTextInputType(ui::TEXT_INPUT_TYPE_PASSWORD);
+  password->SetAccessibleName(u"Master password");
+  password->SetPreferredSize(gfx::Size(360, 0));
+  password_field_ = form_container_->AddChildView(std::move(password));
+
+  auto button_row = std::make_unique<views::View>();
+  button_row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+  signin_button_ = button_row->AddChildView(
+      std::make_unique<views::MdTextButton>(base::BindRepeating(
+          &AegisIdSignInDialog::OnSignInClicked, base::Unretained(this)),
+          u"Sign in"));
+  create_button_ = button_row->AddChildView(
+      std::make_unique<views::MdTextButton>(base::BindRepeating(
+          &AegisIdSignInDialog::OnCreateClicked, base::Unretained(this)),
+          u"Create account"));
+  form_container_->AddChildView(std::move(button_row));
+
+  account_container_ = AddChildView(std::make_unique<views::View>());
+  account_container_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8));
+
+  auto devices = std::make_unique<views::View>();
+  devices->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 4));
+  devices_container_ = account_container_->AddChildView(std::move(devices));
+
+  signout_button_ = account_container_->AddChildView(
+      std::make_unique<views::MdTextButton>(base::BindRepeating(
+          &AegisIdSignInDialog::OnSignOutClicked, base::Unretained(this)),
+          u"Sign out"));
+
+  account_container_->SetVisible(false);
+}
+
+void AegisIdSignInDialog::OnManagerReady() {
+  RefreshState();
+}
+
+void AegisIdSignInDialog::RefreshState() {
+  if (!manager_ || !manager_->ready()) {
+    return;
+  }
+  if (manager_->signed_in() && manager_->session_live()) {
+    ShowAccount();
+  } else if (manager_->signed_in()) {
+    status_label_->SetText(u"Session expired - sign in again");
+    ShowForm();
+  } else {
+    status_label_->SetText(u"Not signed in");
+    ShowForm();
+  }
+}
+
+void AegisIdSignInDialog::ShowForm() {
+  account_container_->SetVisible(false);
+  form_container_->SetVisible(true);
+  PreferredSizeChanged();
+}
+
+void AegisIdSignInDialog::ShowAccount() {
+  form_container_->SetVisible(false);
+  account_container_->SetVisible(true);
+  status_label_->SetText(u"Signed in as " + manager_->email());
+
+  devices_container_->RemoveAllChildViews();
+  auto loading = std::make_unique<views::Label>(
+      u"Loading devices...", views::style::CONTEXT_DIALOG_BODY_TEXT,
+      views::style::STYLE_HINT);
+  loading->SetMultiLine(true);
+  loading->SetPreferredSize(gfx::Size(360, 0));
+  devices_container_->AddChildView(std::move(loading));
+  PreferredSizeChanged();
+
+  manager_->ListDevices(base::BindOnce(&AegisIdSignInDialog::OnDevicesFetched,
+                                       base::Unretained(this)));
+}
+
+void AegisIdSignInDialog::SetBusy(bool busy) {
+  signin_button_->SetEnabled(!busy);
+  create_button_->SetEnabled(!busy);
+  signout_button_->SetEnabled(!busy);
+}
+
+void AegisIdSignInDialog::ShowError(const std::u16string& message) {
+  error_label_->SetText(message);
+  error_label_->SetVisible(!message.empty());
+  PreferredSizeChanged();
+}
+
+void AegisIdSignInDialog::ClearError() {
+  error_label_->SetVisible(false);
+}
+
+void AegisIdSignInDialog::OnSignInClicked() {
+  ClearError();
+  const std::u16string email(email_field_->GetText());
+  const std::u16string password(password_field_->GetText());
+  if (email.empty() || email.find(u'@') == std::u16string::npos) {
+    ShowError(u"Enter the email your Aegis ID was created with.");
+    return;
+  }
+  if (password.empty()) {
+    ShowError(u"Enter your master password.");
+    return;
+  }
+  SetBusy(true);
+  manager_->SignIn(email, password,
+                   base::BindOnce(&AegisIdSignInDialog::OnSignInDone,
+                                  base::Unretained(this)));
+}
+
+void AegisIdSignInDialog::OnCreateClicked() {
+  ClearError();
+  const std::u16string email(email_field_->GetText());
+  const std::u16string password(password_field_->GetText());
+  if (email.empty() || email.find(u'@') == std::u16string::npos) {
+    ShowError(u"Enter an email address to create your Aegis ID with.");
+    return;
+  }
+  if (password.size() < 8) {
+    ShowError(u"Choose a master password of at least 8 characters. There is "
+              u"no reset path: if you lose it, you lose your vault.");
+    return;
+  }
+  SetBusy(true);
+  manager_->CreateAccount(email, password,
+                          base::BindOnce(&AegisIdSignInDialog::OnSignInDone,
+                                         base::Unretained(this)));
+}
+
+void AegisIdSignInDialog::OnSignInDone(bool ok, const std::u16string& message) {
+  SetBusy(false);
+  if (!ok) {
+    ShowError(message);
+    return;
+  }
+  RefreshState();
+}
+
+void AegisIdSignInDialog::OnSignOutClicked() {
+  ClearError();
+  SetBusy(true);
+  manager_->SignOut(base::BindOnce(&AegisIdSignInDialog::OnSignInDone,
+                                   base::Unretained(this)));
+}
+
+void AegisIdSignInDialog::OnDevicesFetched(
+    bool ok,
+    std::vector<AegisDeviceInfo> devices,
+    const std::u16string& message) {
+  if (!account_container_->GetVisible()) {
+    return;  // user already signed out / dialog switched state
+  }
+  devices_container_->RemoveAllChildViews();
+  if (!ok) {
+    auto error = std::make_unique<views::Label>(
+        message, views::style::CONTEXT_DIALOG_BODY_TEXT, views::style::STYLE_HINT);
+    error->SetMultiLine(true);
+    error->SetPreferredSize(gfx::Size(360, 0));
+    devices_container_->AddChildView(std::move(error));
+    PreferredSizeChanged();
+    return;
+  }
+  for (const AegisDeviceInfo& device : devices) {
+    std::u16string row =
+        base::UTF8ToUTF16(device.name.empty() ? device.id : device.name);
+    if (!device.platform.empty()) {
+      row += u" \u2022 " + base::UTF8ToUTF16(device.platform);
+    }
+    if (device.current) {
+      row += u" \u2022 this device";
+    }
+    const std::u16string seen = FormatSeen(device.last_seen_at);
+    if (!seen.empty()) {
+      row += u" \u2022 " + seen;
+    }
+    auto label = std::make_unique<views::Label>(
+        row, views::style::CONTEXT_DIALOG_BODY_TEXT, views::style::STYLE_SECONDARY);
+    label->SetMultiLine(true);
+    label->SetPreferredSize(gfx::Size(360, 0));
+    devices_container_->AddChildView(std::move(label));
+  }
+  if (devices.empty()) {
+    auto empty = std::make_unique<views::Label>(
+        u"No other devices linked to this account.",
+        views::style::CONTEXT_DIALOG_BODY_TEXT, views::style::STYLE_HINT);
+    empty->SetMultiLine(true);
+    empty->SetPreferredSize(gfx::Size(360, 0));
+    devices_container_->AddChildView(std::move(empty));
+  }
+  PreferredSizeChanged();
+}
+
+void ShowAegisIdDialog(Profile* profile) {
+  auto* dialog = new AegisIdSignInDialog(profile);
+  views::DialogDelegate::CreateDialogWidget(dialog, /*context=*/nullptr,
+                                            /*parent=*/nullptr)
+      ->Show();
+}
+
+}  // namespace aegis


+    /** AEGIS (patch 146): the glass treatment for Aegis's own dialogs -
+     *  the stock AlertDialogs here bypass the ModalDialogManager entirely
+     *  (patch 145 only covers that system). Frosted card (cloned window
+     *  background at 85% alpha), blur-behind on API 31+ (reflective: the
+     *  Window.setBlurBehindRadius symbol is absent from Chromium's compile
+     *  SDK stubs), and a light scrim. Cosmetic only - never fails a dialog. */
+    private void glassify(android.app.Dialog dialog) {
+        try {
+            android.view.Window w = dialog.getWindow();
+            if (w == null) return;
+            android.graphics.drawable.Drawable bg =
+                    w.getDecorView().getBackground();
+            if (bg != null && bg.getConstantState() != null) {
+                android.graphics.drawable.Drawable frost =
+                        bg.getConstantState().newDrawable().mutate();
+                frost.setAlpha(216);
+                w.setBackgroundDrawable(frost);
+            }
+            if (android.os.Build.VERSION.SDK_INT
+                    >= android.os.Build.VERSION_CODES.S) {
+                w.addFlags(android.view.WindowManager.LayoutParams.FLAG_BLUR_BEHIND);
+                try {
+                    w.getClass()
+                            .getMethod("setBlurBehindRadius", int.class)
+                            .invoke(
+                                    w,
+                                    (int) (28
+                                            * getResources()
+                                                    .getDisplayMetrics()
+                                                    .density));
+                } catch (Throwable blurError) {
+                    // Blur unsupported - scrim-only glass.
+                }
+            }
+            w.setDimAmount(0.12f);
+        } catch (RuntimeException glassError) {
+            // Keep the stock dialog.
+        }
+    }

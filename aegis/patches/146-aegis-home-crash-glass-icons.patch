+    /** Draws the glyph for a system tile: a gear for Settings, the Aegis
+     *  shield for the private tab - same circle style as letterTile. */
+    private Bitmap systemGlyph(String label, int size) {
+        Bitmap bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bmp);
+        Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        paint.setColor(0xFF2A2A2E);
+        canvas.drawCircle(size / 2f, size / 2f, size / 2f, paint);
+        paint.setColor(0xFFF2F2F7);
+        float cx = size / 2f;
+        float cy = size / 2f;
+        if (label.contains("ettings")) {
+            // Gear: ring, eight spokes, hub.
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(size * 0.09f);
+            canvas.drawCircle(cx, cy, size * 0.26f, paint);
+            for (int i = 0; i < 8; i++) {
+                double ang = Math.PI / 4 * i;
+                canvas.drawLine(
+                        cx + (float) Math.cos(ang) * size * 0.26f,
+                        cy + (float) Math.sin(ang) * size * 0.26f,
+                        cx + (float) Math.cos(ang) * size * 0.38f,
+                        cy + (float) Math.sin(ang) * size * 0.38f,
+                        paint);
+            }
+            paint.setStyle(Paint.Style.FILL);
+            canvas.drawCircle(cx, cy, size * 0.08f, paint);
+        } else {
+            // Shield: outline with a check mark.
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(size * 0.09f);
+            Path shield = new Path();
+            shield.moveTo(cx, size * 0.20f);
+            shield.lineTo(size * 0.76f, size * 0.32f);
+            shield.lineTo(size * 0.76f, size * 0.55f);
+            shield.quadTo(size * 0.76f, size * 0.74f, cx, size * 0.84f);
+            shield.quadTo(size * 0.24f, size * 0.74f, size * 0.24f, size * 0.55f);
+            shield.lineTo(size * 0.24f, size * 0.32f);
+            shield.close();
+            canvas.drawPath(shield, paint);
+            canvas.drawLine(
+                    size * 0.36f, size * 0.52f, cx, size * 0.66f, paint);
+            canvas.drawLine(cx, size * 0.66f, size * 0.66f, size * 0.42f, paint);
+        }
+        return bmp;
     }
 

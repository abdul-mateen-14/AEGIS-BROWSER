+    /** Renders the active-engine chip plus the prepopulated alternates. */
+    private static void buildChips(
+            Context context, LinearLayout chipRow, TemplateUrlService service) {
+        if (!(context instanceof Activity)) return;
+        Activity activity = (Activity) context;
+        if (activity.isFinishing() || activity.isDestroyed()) return;
+        chipRow.removeAllViews();
+        int pad = context.getResources().getDimensionPixelSize(R.dimen.aegis_sheet_padding);
+        TemplateUrl dse = service.getDefaultSearchEngineTemplateUrl();
+        List<TemplateUrl> chips = new ArrayList<>();
+        if (dse != null) chips.add(dse);
+        for (TemplateUrl engine : service.getTemplateUrls()) {
+            if (engine == null || dse == null) continue;
+            String keyword = engine.getKeyword();
+            if (keyword == null || keyword.equals(dse.getKeyword())) continue;
+            for (String wanted : CHIP_KEYWORDS) {
+                if (keyword.contains(wanted)) {
+                    chips.add(engine);
+                    break;
+                }
+            }
+        }
+        for (TemplateUrl engine : chips) {
+            TextView chip = new TextView(context);
+            String name = engine.getShortName();
+            boolean active = dse != null
+                    && engine.getKeyword() != null
+                    && engine.getKeyword().equals(dse.getKeyword());
+            chip.setText(name != null ? name : "");
+            chip.setTextSize(12);
+            chip.setTextColor(context.getColor(
+                    active ? R.color.aegis_accent_on : R.color.aegis_glass_chip_text));
+            GradientDrawable chipBg = new GradientDrawable();
+            chipBg.setColor(context.getColor(
+                    active ? R.color.aegis_glass_chip_active : R.color.aegis_glass_chip));
+            float chipCorner = pad / 2f;
+            chipBg.setCornerRadius(chipCorner);
+            chip.setPadding(pad / 2, pad / 4, pad / 2, pad / 4);
+            chip.setBackground(chipBg);
+            chip.setOnClickListener(
+                    v -> {
+                        String keyword = engine.getKeyword();
+                        if (keyword == null) return;
+                        service.setSearchEngine(keyword);
+                    });
+            LinearLayout.LayoutParams chipLp =
+                    new LinearLayout.LayoutParams(
+                            ViewGroup.LayoutParams.WRAP_CONTENT,
+                            ViewGroup.LayoutParams.WRAP_CONTENT);
+            chipLp.rightMargin = pad / 2;
+            chipRow.addView(chip, chipLp);
+        }
+    }

# Aegis patch 190 - widget picker rebrand + one-time favicon cache refresh
# From the r147 field reports (2026-11-28):
#   1. The quick-action widget picker page still titled itself with the
#      upstream string ("Chromium quick action search"). The resource is
#      not reachable for rebranding, so the manifest receiver now carries
#      the Aegis label literally.
#   2. The widget picker renders STATIC preview PNGs (the live RemoteViews
#      are only used after placement) - the baked-in previews still showed
#      the Google G pill and the "Chrome Dino" card. Both PNGs are replaced
#      with Aegis-branded ones (search pill with the Aegis mark, dino card
#      labeled "Aegis Dino"). Shipped as git binary diffs.
#   3. Sites whose favicons failed to fetch in earlier builds (or that only
#      shipped a proper icon later) stayed on cached letter tiles forever -
#      one-time per-profile migration marks every cached favicon
#      out-of-date so the next visit re-fetches it. Theme-variant favicons
#      (dark/light) that ship PNG links now render correctly after this
#      refresh; SVG-only favicons remain an upstream Android limitation
#      until the renderer rasterizes them.
# Staged alphabetically after 189.

--- a/chrome/android/java/AndroidManifest.xml
+++ b/chrome/android/java/AndroidManifest.xml
@@ -1014,6 +1014,6 @@
         <!-- Quick Action Search widget -->
         <receiver
             android:name="org.chromium.chrome.browser.quickactionsearchwidget.QuickActionSearchWidgetProvider$QuickActionSearchWidgetProviderSearch"
-            android:label="@string/quick_action_search_widget_title"
+            android:label="Aegis quick action search"
             android:exported="true">
             <intent-filter>
--- a/chrome/browser/profiles/profile_impl.cc
+++ b/chrome/browser/profiles/profile_impl.cc
@@ -135,2 +135,6 @@
 #include "components/heavy_ad_intervention/heavy_ad_service.h"
+#include "base/task/cancelable_task_tracker.h"
+#include "base/time/time.h"
+#include "chrome/browser/history/history_service_factory.h"
+#include "components/history/core/browser/history_service.h"
 #include "components/history/core/common/pref_names.h"
@@ -404,4 +404,5 @@
   registry->RegisterBooleanPref(prefs::kSavingBrowserHistoryDisabled, false);
   registry->RegisterBooleanPref(prefs::kAllowDeletingBrowserHistory, true);
+  registry->RegisterBooleanPref("aegis.favicon_refresh_done", false);
   registry->RegisterBooleanPref(policy::policy_prefs::kForceGoogleSafeSearch,
                                 false);
@@ -749,7 +749,24 @@
   pref_change_registrar_.Add(
       prefs::kSupervisedUserId,
       base::BindRepeating(&ProfileImpl::UpdateSupervisedUserIdInStorage,
                           base::Unretained(this)));
+
+  // AEGIS (patch 190): one-time per-profile favicon refresh. Sites whose
+  // favicons failed to fetch in earlier builds (404s, SVG-only icons, late
+  // icon additions) stayed on cached letter tiles; marking every cached
+  // favicon out-of-date makes the next visit re-fetch it. Pref keeps this
+  // to a single pass per profile.
+  if (!prefs->GetBoolean("aegis.favicon_refresh_done")) {
+    prefs->SetBoolean("aegis.favicon_refresh_done", true);
+    history::HistoryService* aegis_hs = HistoryServiceFactory::GetForProfile(
+        this, ServiceAccessType::IMPLICIT_ACCESS);
+    if (aegis_hs) {
+      static base::CancelableTaskTracker* aegis_tracker =
+          new base::CancelableTaskTracker();
+      aegis_hs->SetFaviconsOutOfDateBetween(base::Time(), base::Time::Now(),
+                                            base::DoNothing(), aegis_tracker);
+    }
+  }
 
   // Changes in the profile avatar.
   pref_change_registrar_.Add(

+    private void launchBookmarkImportPicker() {
+        try {
+            startActivityForResult(
+                    new Intent(Intent.ACTION_OPEN_DOCUMENT)
+                            .addCategory(Intent.CATEGORY_OPENABLE)
+                            .setType("*/*")
+                            .putExtra(Intent.EXTRA_MIME_TYPES,
+                                    new String[] {"text/html", "text/plain",
+                                            "application/xhtml+xml"}),
+                    AegisBookmarkImporter.IMPORT_REQUEST_CODE);
+        } catch (ActivityNotFoundException e) {
+            Toast.makeText(getContext(), "No file picker available", Toast.LENGTH_SHORT)
+                    .show();
+        }
+    }
+
+    @Override
+    public void onActivityResult(int requestCode, int resultCode, @Nullable Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode != AegisBookmarkImporter.IMPORT_REQUEST_CODE) return;
+        if (data == null || data.getData() == null || getContext() == null) return;
+        AegisBookmarkImporter.importFromUri(requireContext(), data.getData());
+    }

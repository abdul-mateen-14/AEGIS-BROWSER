+/**
+ * Aegis: import bookmarks from a Netscape-format bookmarks HTML file (the
+ * export format of every major browser) into the mobile bookmarks folder.
+ *
+ * The file is parsed on a background task through the ContentResolver; the
+ * bookmark-model mutations are applied back on the UI thread, as required by
+ * the native bookmark bridge.
+ */
+public class AegisBookmarkImporter {
+    private static final String ROOT_FOLDER_TITLE = "Imported bookmarks";
+    /** Request code for the Settings document picker. */
+    public static final int IMPORT_REQUEST_CODE = 9001;
+    /** Request code for the Settings document picker. */
+    public static final int IMPORT_REQUEST_CODE = 9001;
+    /** Request code for the Settings document picker. */
+    public static final int IMPORT_REQUEST_CODE = 9001;
+
+    /** One parsed entry: a folder ({@code url == null}) or a bookmark. */
+    private static class Node {
+        public final String title;
+        public final String url;
+        public final List<Node> children = new ArrayList<>();
+
+        public Node(String title, String url) {
+            this.title = title;
+            this.url = url;
+        }
+    }
+
+    private AegisBookmarkImporter() {}
+
+    /**
+     * Opens {@code uri} via ContentResolver, parses the HTML on a background
+     * task and imports it. Must be called from the UI thread.
+     */
+    public static void importFromUri(Context context, Uri uri) {
+        PostTask.postTask(TaskTraits.BEST_EFFORT_MAY_BLOCK, () -> {
+            Node root;
+            try (InputStream in = context.getContentResolver().openInputStream(uri)) {
+                root = parse(in);
+            } catch (IOException | SecurityException | IllegalArgumentException e) {
+                ThreadUtils.postOnUiThread(() -> report(context, 0, 0, 1));
+                return;
+            }
+            ThreadUtils.postOnUiThread(() -> importTree(context, root));
+        });
+    }
+
+    private static void importTree(Context context, Node root) {
+        BookmarkModel model =
+                BookmarkModel.getForProfile(Profile.getLastUsedRegularProfile());
+        if (model == null || !model.isBookmarkModelLoaded()) {
+            // The model loads right after start-up; retry once on the next UI pass.
+            ThreadUtils.postOnUiThreadDelayed(
+                    () -> importTree(context, root), 500);
+            return;
+        }
+        doImport(context, model, root);
+    }
+
+    private static void doImport(Context context, BookmarkModel model, Node root) {
+        BookmarkId parent = model.getMobileFolderId();
+        if (parent == null) parent = model.getOtherFolderId();
+        if (parent == null) parent = model.getRootFolderId();
+        if (parent == null) {
+            report(context, 0, 0, 1);
+            return;
+        }
+        BookmarkId target = model.addFolder(parent, model.getChildCount(parent),
+                ROOT_FOLDER_TITLE);
+        if (target == null) {
+            report(context, 0, 0, 1);
+            return;
+        }
+        int[] folders = new int[] {0};
+        int[] bookmarks = new int[] {0};
+        int[] skipped = new int[] {0};
+        Set<String> seen = new HashSet<>();
+        for (Node child : root.children) {
+            insert(model, target, child, folders, bookmarks, skipped, seen);
+        }
+        report(context, bookmarks[0], folders[0], skipped[0]);
+    }
+
+    private static void insert(BookmarkModel model, BookmarkId parent, Node node,
+            int[] folders, int[] bookmarks, int[] skipped, Set<String> seen) {
+        if (node.url != null) {
+            if (!seen.add(node.url) || skipped[0] > 5000) {
+                skipped[0]++;
+                return;
+            }
+            GURL gurl = new GURL(node.url);
+            if (!gurl.isValid()) {
+                skipped[0]++;
+                return;
+            }
+            String title =
+                    node.title == null || node.title.isEmpty() ? node.url : node.title;
+            if (model.addBookmark(parent, model.getChildCount(parent), title, gurl)
+                    == null) {
+                skipped[0]++;
+                return;
+            }
+            bookmarks[0]++;
+        } else {
+            String title =
+                    node.title == null || node.title.isEmpty() ? "Folder" : node.title;
+            BookmarkId folder =
+                    model.addFolder(parent, model.getChildCount(parent), title);
+            if (folder == null) {
+                skipped[0]++;
+                return;
+            }
+            folders[0]++;
+            for (Node child : node.children) {
+                insert(model, folder, child, folders, bookmarks, skipped, seen);
+            }
+        }
+    }
+
+    private static void report(
+            Context context, int bookmarks, int folders, int skipped) {
+        String message;
+        if (bookmarks == 0 && folders == 0) {
+            message = "No bookmarks imported - is this a bookmarks HTML file?";
+        } else if (skipped > 0) {
+            message = "Imported " + bookmarks + " bookmarks (" + folders
+                    + " folders), " + skipped + " skipped";
+        } else {
+            message = "Imported " + bookmarks + " bookmarks (" + folders + " folders)";
+        }
+        Toast.makeText(context, message, Toast.LENGTH_LONG).show();
+    }
+
+    // ----- Netscape bookmarks HTML parsing -----
+
+    /**
+     * Parses a Netscape bookmarks HTML stream into a tree. Small state machine:
+     * folders arrive as {@code <DT><H3>name</H3>} followed by {@code <DL>},
+     * entries as {@code <DT><A HREF="...">title</A>}.
+     */
+    private static Node parse(InputStream in) throws IOException {
+        Node root = new Node(ROOT_FOLDER_TITLE, null);
+        List<Node> stack = new ArrayList<>();
+        stack.add(root);
+        String pendingFolder = null;
+        try (Scanner scanner =
+                        new Scanner(in, StandardCharsets.UTF_8.name()).useDelimiter("\n")) {
+            while (scanner.hasNext()) {
+                String line = scanner.next();
+                if (line == null) continue;
+                String trimmed = line.trim();
+                if (trimmed.isEmpty()) continue;
+                String upper = trimmed.toUpperCase(Locale.US);
+                if (upper.contains("<H3")) {
+                    pendingFolder = extractTagText(trimmed, "<H3", "</H3>");
+                } else if (upper.contains("<DL")) {
+                    String title = pendingFolder == null ? "Folder" : pendingFolder;
+                    pendingFolder = null;
+                    Node folder = new Node(unescape(title), null);
+                    stack.get(stack.size() - 1).children.add(folder);
+                    stack.add(folder);
+                } else if (upper.contains("</DL")) {
+                    if (stack.size() > 1) stack.remove(stack.size() - 1);
+                } else if (upper.contains("<A ")) {
+                    String href = extractHref(trimmed);
+                    if (href == null) continue;
+                    String low = href.toLowerCase(Locale.US);
+                    if (!low.startsWith("http://") && !low.startsWith("https://")) {
+                        continue;
+                    }
+                    String text = extractTagText(trimmed, "<A", "</A>");
+                    Node entry = new Node(unescape(text == null ? "" : text), href);
+                    stack.get(stack.size() - 1).children.add(entry);
+                }
+            }
+        }
+        return root;
+    }
+
+    /** Returns the inner text of the first {@code openTag}...{@code closeTag}. */
+    private static String extractTagText(String line, String openTag, String closeTag) {
+        int open = indexOfIgnoreCase(line, openTag);
+        if (open < 0) return "";
+        int gt = line.indexOf('>', open);
+        if (gt < 0) return "";
+        int close = indexOfIgnoreCase(line, closeTag);
+        if (close < 0 || close <= gt) return line.substring(gt + 1).trim();
+        return line.substring(gt + 1, close).trim();
+    }
+
+    /** Returns the HREF attribute value of the first anchor on the line. */
+    private static String extractHref(String line) {
+        int a = indexOfIgnoreCase(line, "HREF=");
+        if (a < 0) return null;
+        int rest = a + "HREF=".length();
+        if (rest >= line.length()) return null;
+        char quote = line.charAt(rest);
+        if (quote == '"' || quote == '\'') {
+            int end = line.indexOf(quote, rest + 1);
+            if (end < 0) return null;
+            return line.substring(rest + 1, end);
+        }
+        int end = rest;
+        while (end < line.length() && line.charAt(end) != ' ' && line.charAt(end) != '>') {
+            end++;
+        }
+        return line.substring(rest, end);
+    }
+
+    private static int indexOfIgnoreCase(String haystack, String needle) {
+        return haystack.toUpperCase(Locale.US).indexOf(needle.toUpperCase(Locale.US));
+    }
+
+    private static String unescape(String s) {
+        if (s.indexOf('&') < 0) return s;
+        return s.replace("&amp;", "&")
+                .replace("&lt;", "<")
+                .replace("&gt;", ">")
+                .replace("&quot;", "\"")
+                .replace("&apos;", "'")
+                .replace("&#39;", "'");
+    }
+}


--- a/content/public/browser/webui_config_map.cc
+++ b/content/public/browser/webui_config_map.cc
@@ -21,6 +21,19 @@ namespace content {
 
 namespace {
 
+// Aegis (patch 123): aegis:// is an alias scheme for chrome:// WebUIs. The
+// alias is registered as a standard/secure scheme in url_schemes.cc and is
+// resolved to chrome:// before every WebUIConfigMap lookup, so
+// aegis://version and chrome://version serve the same WebUI.
+GURL ResolveAegisWebUIUrl(const GURL& url) {
+  if (!url.SchemeIs(kAegisUIScheme)) {
+    return url;
+  }
+  GURL::Replacements replacements;
+  replacements.SetSchemeStr(kChromeUIScheme);
+  return url.ReplaceComponents(replacements);
+}
+
 // Owned by WebUIConfigMap. Used to hook up with the existing WebUI infra.
 class WebUIConfigMapWebUIControllerFactory : public WebUIControllerFactory {
  public:
@@ -30,21 +43,23 @@ class WebUIConfigMapWebUIControllerFactory : public WebUIControllerFactory {
 
   WebUI::TypeID GetWebUIType(BrowserContext* browser_context,
                              const GURL& url) override {
-    auto* config = config_map_->GetConfig(browser_context, url);
+    auto* config =
+        config_map_->GetConfig(browser_context, ResolveAegisWebUIUrl(url));
     return config ? reinterpret_cast<WebUI::TypeID>(config) : WebUI::kNoWebUI;
   }
 
   bool UseWebUIForURL(BrowserContext* browser_context,
                       const GURL& url) override {
-    return config_map_->GetConfig(browser_context, url);
+    return config_map_->GetConfig(browser_context, ResolveAegisWebUIUrl(url));
   }
 

+    /**
+     * AEGIS (patch 187): the passwords row must report the real local
+     * store, not the Google Play services store the native counter reads.
+     * Counts the credentials the Aegis Passwords manager lists and
+     * formats the summary with up to two example domains.
+     */
+    private void showAegisPasswordSummary(Item item, String nativeSummary) {
+        PasswordStoreBridge bridge = null;
+        try {
+            bridge = new PasswordStoreBridge(getProfile());
+            PasswordStoreCredential[] creds = bridge.getAllCredentials();
+            int count = creds.length;
+            if (count == 0) {
+                item.applySummary("None");
+                return;
+            }
+            java.util.LinkedHashSet<String> domains =
+                    new java.util.LinkedHashSet<>();
+            for (PasswordStoreCredential cred : creds) {
+                GURL url = cred.getUrl();
+                if (url != null && !url.getHost().isEmpty()) {
+                    domains.add(url.getHost());
+                }
+                if (domains.size() == 2) break;
+            }
+            StringBuilder text = new StringBuilder();
+            text.append(count == 1 ? "1 password" : count + " passwords");
+            if (!domains.isEmpty()) {
+                text.append(" (for ").append(String.join(", ", domains))
+                        .append(")");
+            }
+            item.applySummary(text.toString());
+        } catch (Exception e) {
+            item.applySummary(nativeSummary);
+        } finally {
+            if (bridge != null) bridge.destroy();
+        }
+    }

+    // --- session persistence (patch 191) ---------------------------------
+    // Seals {refresh, access, vaultKey} into one prefs blob under an
+    // AndroidKeyStore AES-GCM key (non-exportable, device-bound).
+    private SecretKey sessionKey() {
+        try {
+            KeyStore ks = KeyStore.getInstance("AndroidKeyStore");
+            ks.load(null);
+            java.security.Key existing = ks.getKey(KEYSTORE_ALIAS, null);
+            if (existing instanceof SecretKey) return (SecretKey) existing;
+            KeyGenerator kg = KeyGenerator.getInstance(
+                    KeyProperties.KEY_ALGORITHM_AES, "AndroidKeyStore");
+            kg.init(new KeyGenParameterSpec.Builder(KEYSTORE_ALIAS,
+                    KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)
+                    .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                    .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                    .setKeySize(256)
+                    .build());
+            return kg.generateKey();
+        } catch (Exception e) {
+            return null; // keystore unavailable - session stays volatile
+        }
+    }
+
+    private void persistSession() {
+        if (mRefreshToken == null || mAccessToken == null) return;
+        SecretKey key = sessionKey();
+        if (key == null) return;
+        try {
+            JSONObject j = new JSONObject()
+                    .put("rt", mRefreshToken)
+                    .put("at", mAccessToken)
+                    .put("vk", mVaultKey == null ? "" : AegisCrypto.b64(mVaultKey));
+            byte[] plain = j.toString().getBytes(StandardCharsets.UTF_8);
+            Cipher c = Cipher.getInstance("AES/GCM/NoPadding");
+            c.init(Cipher.ENCRYPT_MODE, key);
+            byte[] iv = c.getIV();
+            byte[] ct = c.doFinal(plain);
+            byte[] blob = new byte[iv.length + ct.length];
+            System.arraycopy(iv, 0, blob, 0, iv.length);
+            System.arraycopy(ct, 0, blob, iv.length, ct.length);
+            mPrefs.edit().putString(KEY_SESSION_BLOB,
+                    Base64.encodeToString(blob, Base64.NO_WRAP)).apply();
+        } catch (Exception e) {
+            // best-effort: the volatile session keeps working either way
+        }
+    }
+
+    private void restoreSession() {
+        String blob = mPrefs.getString(KEY_SESSION_BLOB, "");
+        SecretKey key = sessionKey();
+        if (blob.isEmpty() || key == null) return;
+        try {
+            byte[] raw = Base64.decode(blob, Base64.NO_WRAP);
+            Cipher c = Cipher.getInstance("AES/GCM/NoPadding");
+            c.init(Cipher.DECRYPT_MODE, key, new GCMParameterSpec(128, raw, 0, 12));
+            JSONObject j = new JSONObject(new String(
+                    c.doFinal(raw, 12, raw.length - 12), StandardCharsets.UTF_8));
+            mRefreshToken = j.getString("rt");
+            mAccessToken = j.getString("at");
+            String vk = j.optString("vk", "");
+            if (!vk.isEmpty()) mVaultKey = AegisCrypto.unb64(vk);
+            if (mClient != null) {
+                mClient.setTokens(mAccessToken, mRefreshToken);
+                if (mVaultKey != null) mClient.setVaultKey(mVaultKey);
+            }
+        } catch (Exception e) {
+            // a blob the keystore cannot open is stale - drop it so the
+            // next sign-in writes a fresh one
+            mPrefs.edit().remove(KEY_SESSION_BLOB).apply();
+        }
+    }
+
     private void clearSession() {
         mAccessToken = null;
         mRefreshToken = null;
         mVaultKey = null;

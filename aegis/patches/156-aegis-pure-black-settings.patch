     <color name="tab_pip_alert_color">@color/baseline_primary_80</color>
+
+    <!-- AEGIS (patch 156, r106 user review: "why isn't the settings pure
+         black like home page"): in dark mode the settings page background
+         followed Chromium's dark-gray default_bg_color while the Aegis
+         home is pure black. This override merges into the values/
+         definition of the settings theme for the night configuration only;
+         light mode is untouched. The style lives inside this registered
+         values-night file because new res files must be added to the
+         BUILD.gn sources list to compile (APK #112 lesson). -->
+    <style name="Base.Theme.Chromium.Settings">
+        <item name="android:colorBackground">@android:color/black</item>
+        <item name="android:statusBarColor">@android:color/black</item>
+        <item name="android:navigationBarColor">@android:color/black</item>
+        <item name="android:windowLightStatusBar">false</item>
+        <item name="android:windowLightNavigationBar">false</item>
+    </style>
 </resources>

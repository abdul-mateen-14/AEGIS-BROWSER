+    /** Patch 138 (user tabsm.png): reorder affordance - moves the tab one
+     *  slot up/down inside its model (TabModel.moveTab, 156); the panel
+     *  re-renders via the existing rebuild(). */
+    private TextView moveButton(Tab tab, boolean private_, boolean up) {
+        TextView move = new TextView(getContext());
+        move.setText(up ? "\u2191" : "\u2193");
+        move.setTextSize(14);
+        move.setTextColor(getContext().getColor(
+                private_ ? R.color.aegis_text_secondary_inverted
+                         : R.color.aegis_text_secondary));
+        move.setClickable(true);
+        move.setFocusable(true);
+        move.setPadding(6, 0, 6, 0);
+        // Patch 138 v3 (APK RED 44054782081): literal labels - the strings
+        // this patch adds to aegis_tokens.xml are not reliably visible to
+        // javac while the banked res pipeline ships stale (value resources
+        // are ACTION-edge inputs ninja cannot invalidate); these content
+        // descriptions are invisible UI text, so literals keep the compile
+        // independent of res staleness.
+        move.setContentDescription(up ? "Move up" : "Move down");
+        move.setOnClickListener(
+                v -> {
+                    TabModel model =
+                            ((ChromeTabbedActivity) dock().getContext())
+                                    .getTabModelSelector()
+                                    .getModel(private_);
+                    if (model == null) return;
+                    int idx = -1;
+                    for (int i = 0; i < model.getCount(); i++) {
+                        if (model.getTabAt(i) == tab) {
+                            idx = i;
+                            break;
+                        }
+                    }
+                    int target = up ? idx - 1 : idx + 1;
+                    if (idx < 0 || target < 0 || target >= model.getCount()) return;
+                    model.moveTab(tab.getId(), target);
+                    rebuild();
+                });
+        return move;
+    }

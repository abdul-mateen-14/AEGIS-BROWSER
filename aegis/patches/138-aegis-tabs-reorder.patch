+    /** Patch 138 v4: moves the dragged tab to the position of the card
+     *  under the drag point (same model only); re-renders on change. */
+    private void handleDragLocation(Tab dragged, float y) {
+        if (mPanel == null) return;
+        LinearLayout list = findDragList();
+        if (list == null) return;
+        TabModel model =
+                ((ChromeTabbedActivity) dock().getContext())
+                        .getTabModelSelector()
+                        .getModel(dragged.isIncognito());
+        if (model == null) return;
+        int draggedIdx = -1;
+        for (int i = 0; i < model.getCount(); i++) {
+            if (model.getTabAt(i) == dragged) {
+                draggedIdx = i;
+                break;
+            }
+        }
+        if (draggedIdx < 0) return;
+        for (int i = 0; i < list.getChildCount(); i++) {
+            View child = list.getChildAt(i);
+            if (child.getTop() <= y && y <= child.getBottom()
+                    && child.getTag() instanceof Tab) {
+                Tab under = (Tab) child.getTag();
+                if (under == dragged || under.isIncognito() != dragged.isIncognito()) {
+                    return;
+                }
+                int target = -1;
+                for (int j = 0; j < model.getCount(); j++) {
+                    if (model.getTabAt(j) == under) {
+                        target = j;
+                        break;
+                    }
+                }
+                if (target >= 0 && target != draggedIdx) {
+                    model.moveTab(dragged.getId(), target);
+                    rebuild();
+                }
+                return;
+            }
+        }
+    }
+
+    /** Patch 138 v4: the card list is rebuilt on every reorder - re-find
+     *  the current instance for drag hit-testing. */
+    private LinearLayout findDragList() {
+        for (int i = 0; i < mPanel.getChildCount(); i++) {
+            View child = mPanel.getChildAt(i);
+            if (child instanceof ScrollView) {
+                ViewGroup inner = (ViewGroup) ((ScrollView) child).getChildAt(0);
+                if (inner instanceof LinearLayout) return (LinearLayout) inner;
+            }
+        }
+        return null;
+    }

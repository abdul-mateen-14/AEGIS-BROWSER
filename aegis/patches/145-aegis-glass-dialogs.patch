+        // with blur-behind (API 31+) and a light scrim, so the app reads
+        // through as frosted glass behind the themed card. Glass is cosmetic
+        // and must never break a dialog - guarded, no-ops below API 31.
+        Window aegisGlassWindow = mDialog.getWindow();

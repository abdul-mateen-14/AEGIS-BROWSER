# 117 - aegis-popups-off (r60 wave, user feedback 2026-11-13)
# "Remove all the Chrome popups when we launch Android or desktop app -
# login notifications, default, etc. Use our own which matches our
# design."
#
# Two remaining popup sources (FRE skip + notification-string rebrand
# already shipped in 088):
#
# 1. Desktop What's New - a Google-branded tab that pops after every
#    update. whats_new::ShouldShowForState() (the startup trigger used by
#    StartupBrowserCreator) now hard-returns false.
# 2. Android default-browser promos - DefaultBrowserPromoUtils gates:
#    isFeatureEnabled() (role-manager dialogs via FRE/startup/app-menu),
#    shouldShowNonRoleManagerPromo() (message banner), and
#    maybeShowDefaultBrowserPromoMessages() (startup message). All return
#    false / bail before any promo logic runs. The Settings default-
#    browser page remains fully functional.
--- a/chrome/browser/ui/webui/whats_new/whats_new_util.cc
+++ b/chrome/browser/ui/webui/whats_new/whats_new_util.cc
@@ -58,6 +58,9 @@
 
 bool ShouldShowForState(PrefService* local_state,
                         bool promotional_tabs_enabled) {
+  // Aegis (patch 117): What's New is a Google-branded surface that pops a
+  // tab after every update. Disabled outright for this privacy browser.
+  return false;
 #if BUILDFLAG(IS_CHROMEOS)
   return false;
 #else

--- a/chrome/browser/ui/android/default_browser_promo/java/src/org/chromium/chrome/browser/ui/default_browser_promo/DefaultBrowserPromoUtils.java
+++ b/chrome/browser/ui/android/default_browser_promo/java/src/org/chromium/chrome/browser/ui/default_browser_promo/DefaultBrowserPromoUtils.java
@@ -117,7 +117,8 @@
     }
 
     static boolean isFeatureEnabled() {
-        return !CommandLine.getInstance().hasSwitch(ChromeSwitches.DISABLE_DEFAULT_BROWSER_PROMO);
+        // Aegis (patch 117): no default-browser role-manager promos.
+        return false;
     }
 
     /**
@@ -160,6 +161,10 @@
      */
     public void maybeShowDefaultBrowserPromoMessages(
             Context context, WindowAndroid windowAndroid, Profile profile) {
+        if (true) {
+            // Aegis (patch 117): no default-browser promo messages.
+            return;
+        }
         if (!ChromeFeatureList.isEnabled(ChromeFeatureList.DEFAULT_BROWSER_PROMO_ANDROID2)) {
             return;
         }
@@ -193,6 +198,10 @@
      * max count) is met. 4. The current default browser state satisfies the pre-defined conditions.
      */
     public boolean shouldShowNonRoleManagerPromo(Context context) {
+        if (true) {
+            // Aegis (patch 117): no default-browser message-banner promos.
+            return false;
+        }
         if (sDelegate != null && sDelegate.shouldSuppressPromo()) {
             return false;
         }

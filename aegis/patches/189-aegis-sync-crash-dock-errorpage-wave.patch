+
+    /**
+     * AEGIS (patch 189): fills the recommendation box for the query being
+     * typed. Open tabs match on title and URL; the famous-place list
+     * matches on name and host. Tapping a row navigates exactly like the
+     * query field itself (same resolve/load path as {@link #go}).
+     */
+    private static void renderSuggestions(
+            AegisSearchSheet sheet, LinearLayout box, EditText input, int pad) {
+        Context context = sheet.getContext();
+        Activity activity = (Activity) context;
+        if (!(activity instanceof ChromeTabbedActivity)) return;
+        ChromeTabbedActivity cta = (ChromeTabbedActivity) activity;
+        String query = input.getText() == null ? "" : input.getText().toString().trim();
+        String lower = query.toLowerCase();
+        List<String[]> rows = new ArrayList<>();
+        org.chromium.chrome.browser.tabmodel.TabModel normal =
+                cta.getTabModelSelector().getModel(false);
+        if (normal != null) {
+            for (int i = 0; i < normal.getCount() && rows.size() < 4; i++) {
+                Tab tab = normal.getTabAt(i);
+                if (tab == null || tab.getUrl() == null) continue;
+                String spec = tab.getUrl().getSpec();
+                if (spec.startsWith("chrome-native://newtab")) continue;
+                String title = tab.getTitle();
+                boolean hit = query.isEmpty()
+                        || (title != null && title.toLowerCase().contains(lower))
+                        || spec.toLowerCase().contains(lower);
+                if (hit) {
+                    rows.add(new String[] {
+                            title != null && !title.isEmpty() ? title : spec,
+                            spec});
+                }
+            }
+        }
+        for (String[] fav : FAMOUS_PLACES) {
+            if (rows.size() >= 7) break;
+            if (query.isEmpty()
+                    || fav[0].toLowerCase().contains(lower)
+                    || fav[1].toLowerCase().contains(lower)) {
+                rows.add(fav);
+            }
+        }
+        if (rows.isEmpty()) return;
+        box.removeAllViews();
+        TextView head = new TextView(context);
+        head.setText(context.getString(R.string.aegis_dock_suggestions));
+        head.setTextSize(11);
+        head.setAllCaps(true);
+        head.setTextColor(
+                context.getColor(R.color.aegis_glass_text_secondary));
+        head.setPadding(0, pad / 2, 0, 0);
+        box.addView(head);
+        for (String[] row : rows) {
+            TextView item = new TextView(context);
+            item.setSingleLine(true);
+            item.setEllipsize(android.text.TextUtils.TruncateAt.END);
+            item.setText(row[0]);
+            item.setTextSize(14);
+            item.setTextColor(context.getColor(R.color.aegis_glass_text));
+            item.setPadding(0, pad / 2, 0, pad / 2);
+            item.setOnClickListener(v -> {
+                dismiss(sheet);
+                LoadUrlParams params = new LoadUrlParams(row[1]);
+                Tab tab = cta.getActivityTab();
+                if (tab != null) {
+                    tab.loadUrl(params);
+                } else {
+                    cta.getTabCreator(false)
+                            .createNewTab(params, TabLaunchType.FROM_LINK,
+                                    /* parent= */ null);
+                }
+            });
+            box.addView(item);
+        }
+    }
 }

# 121 - aegis-desktop-identity (user feedback 2026-11-13: "why chromium logo
# is still there", settings header Chrome logo)
# The version page (chrome://version) and the settings About page still paint
# Chromium product logo PNGs (IDR_PRODUCT_LOGO / current-channel-logo are
# binary theme assets, so the earlier SVG swap in patch 107 never reached
# them). Both pages now render an inline Aegis mark (rounded dark tile +
# outlined triangle) with the Aegis wordmark - no Chromium asset remains.
# Also retitles the version page "About Aegis".

--- a/chrome/browser/resources/settings/about_page/about_page.html.ts
+++ b/chrome/browser/resources/settings/about_page/about_page.html.ts
@@ -13,11 +13,13 @@ export function getHtml(this: SettingsAboutPageElement) {
   return html`<!--_html_template_start_-->
 <settings-section page-title="$i18n{aboutPageTitle}">
   <div class="cr-row two-line first">
-    <img id="productLogo" @click="${this.onProductLogoClick_}"
-        srcset="chrome://theme/current-channel-logo@1x 1x,
-                chrome://theme/current-channel-logo@2x 2x"
-        alt="$i18n{aboutProductLogoAlt}"
-        role="presentation">
+    <svg id="productLogo" class="aegis-mark" viewBox="0 0 108 108" width="40"
+        height="40" @click="${this.onProductLogoClick_}"
+        role="img" aria-label="$i18n{aboutProductLogoAlt}">
+      <rect x="2" y="2" width="104" height="104" rx="26" fill="#1C1C1E"/>
+      <path d="M54 30 L79 80 L29 80 Z" fill="none" stroke="#F2F2F7"
+            stroke-width="7" stroke-linejoin="round"/>
+    </svg>
     <div class="product-title">$i18n{aboutProductTitle}</div>
   </div>
   <div class="cr-row two-line">

+    /**
+     * Whether the platform can blur behind windows. Many OEM/low-RAM
+     * devices ship with window blur disabled - a translucent glass over a
+     * non-blurred page lets the page text collide with the dialog text
+     * (r106 device screenshots on Infinix X6728B / HiOS).
+     */
+    public static boolean blurEnabled(Context context) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) return false;
+        try {
+            android.view.WindowManager wm =
+                    context.getSystemService(android.view.WindowManager.class);
+            return wm != null && wm.isCrossWindowBlurEnabled();
+        } catch (RuntimeException blurCheckError) {
+            return false;
+        }
+    }

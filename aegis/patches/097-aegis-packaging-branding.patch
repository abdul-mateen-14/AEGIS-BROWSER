# 97 - packaging-level branding: chromium-browser.info (menu name, package id, install dir, URLs, RDN) + installer BUILD.gn package var so deb filename matches control
# generated by scripts/gen_string_patch.py against tag 156.0.8078.79
# all edits count-asserted

--- a/chrome/installer/linux/common/chromium-browser.info
+++ b/chrome/installer/linux/common/chromium-browser.info

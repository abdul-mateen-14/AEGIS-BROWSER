+package org.chromium.chrome.browser.aegis;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.graphics.Typeface;
+
+import org.chromium.build.annotations.NullMarked;
+
+/**
+ * Brand marks for the dock search sheet engine chips (patch 161, r116
+ * review: "show their logo not names"). Everything is drawn with plain
+ * android.graphics primitives - no binary assets, no network favicons, so
+ * the row renders identically offline and per theme.
+ */
+@NullMarked
+public final class AegisEngineIcons {
+    private AegisEngineIcons() {}
+
+    /**
+     * The logo for a prepopulated engine keyword, drawn at {@code sizePx}.
+     * {@code dark} is the sheet's dark mode (the bare Aegis mark switches
+     * ink; the four third-party logos sit on their own brand discs).
+     */
+    public static Bitmap iconFor(String keyword, int sizePx, boolean dark) {
+        String k = keyword == null ? "" : keyword.toLowerCase();
+        if (k.contains("aegis")) return aegis(sizePx, dark);
+        if (k.contains("duckduckgo")) return duckduckgo(sizePx);
+        if (k.contains("google")) return google(sizePx);
+        if (k.contains("bing")) return bing(sizePx);
+        if (k.contains("chatgpt") || k.contains("openai")) return openai(sizePx);
+        return aegis(sizePx, dark);
+    }
+
+    private static Paint fill(int color) {
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        p.setColor(color);
+        return p;
+    }
+
+    private static Bitmap disc(int sizePx, int color) {
+        Bitmap bmp = Bitmap.createBitmap(sizePx, sizePx, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bmp);
+        canvas.drawCircle(sizePx / 2f, sizePx / 2f, sizePx / 2f, fill(color));
+        return bmp;
+    }
+
+    /** The Aegis shield mark (accent-on-glass, same geometry as home). */
+    private static Bitmap aegis(int sizePx, boolean dark) {
+        Bitmap bmp = Bitmap.createBitmap(sizePx, sizePx, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bmp);
+        Paint paint = fill(dark ? 0xFFF6F6F7 : 0xFF0A0A0B);
+        float cx = sizePx / 2f;
+        Path shield = new Path();
+        shield.moveTo(cx, sizePx * 0.14f);
+        shield.lineTo(sizePx * 0.82f, sizePx * 0.28f);
+        shield.lineTo(sizePx * 0.82f, sizePx * 0.55f);
+        shield.quadTo(sizePx * 0.82f, sizePx * 0.78f, cx, sizePx * 0.90f);
+        shield.quadTo(sizePx * 0.18f, sizePx * 0.78f, sizePx * 0.18f, sizePx * 0.55f);
+        shield.lineTo(sizePx * 0.18f, sizePx * 0.28f);
+        shield.close();
+        canvas.drawPath(shield, paint);
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(sizePx * 0.07f);
+        paint.setColor(dark ? 0xFF0A0A0B : 0xFFF6F6F7);
+        canvas.drawLine(sizePx * 0.38f, sizePx * 0.52f, cx, sizePx * 0.68f, paint);
+        canvas.drawLine(cx, sizePx * 0.68f, sizePx * 0.66f, sizePx * 0.40f, paint);
+        return bmp;
+    }
+
+    /** DuckDuckGo: red disc with a simple white duck glyph. */
+    private static Bitmap duckduckgo(int sizePx) {
+        Bitmap bmp = disc(sizePx, 0xFFDE5833);
+        Canvas canvas = new Canvas(bmp);
+        Paint white = fill(0xFFFFFFFF);
+        // head
+        canvas.drawCircle(sizePx * 0.52f, sizePx * 0.42f, sizePx * 0.16f, white);
+        // body
+        canvas.drawCircle(sizePx * 0.46f, sizePx * 0.62f, sizePx * 0.19f, white);
+        // beak
+        Paint orange = fill(0xFFF0A030);
+        Path beak = new Path();
+        beak.moveTo(sizePx * 0.64f, sizePx * 0.40f);
+        beak.lineTo(sizePx * 0.82f, sizePx * 0.45f);
+        beak.lineTo(sizePx * 0.64f, sizePx * 0.50f);
+        beak.close();
+        canvas.drawPath(beak, orange);
+        // eye
+        canvas.drawCircle(sizePx * 0.56f, sizePx * 0.38f, sizePx * 0.035f, fill(0xFF2D2D2D));
+        return bmp;
+    }
+
+    /** Google: the four-color G on white. */
+    private static Bitmap google(int sizePx) {
+        Bitmap bmp = disc(sizePx, 0xFFFFFFFF);
+        Canvas canvas = new Canvas(bmp);
+        float r = sizePx * 0.30f;
+        float cx = sizePx / 2f;
+        float cy = sizePx / 2f;
+        float stroke = sizePx * 0.135f;
+        RectF oval = new RectF(cx - r, cy - r, cx + r, cy + r);
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        p.setStyle(Paint.Style.STROKE);
+        p.setStrokeWidth(stroke);
+        // red top
+        p.setColor(0xFFEA4335);
+        canvas.drawArc(oval, 150f, 95f, false, p);
+        // yellow left-bottom
+        p.setColor(0xFFFBBC05);
+        canvas.drawArc(oval, 245f, 65f, false, p);
+        // green bottom
+        p.setColor(0xFF34A853);
+        canvas.drawArc(oval, 310f, 85f, false, p);
+        // blue right arc + bar
+        p.setColor(0xFF4285F4);
+        canvas.drawArc(oval, 35f, 65f, false, p);
+        canvas.drawRect(cx + r - stroke / 2f, cy - stroke / 2f, cx + r + stroke / 2f,
+                cy + r, p);
+        return bmp;
+    }
+
+    /** Bing: teal disc with the lowercase b. */
+    private static Bitmap bing(int sizePx) {
+        Bitmap bmp = disc(sizePx, 0xFF008373);
+        Canvas canvas = new Canvas(bmp);
+        Paint white = fill(0xFFFFFFFF);
+        white.setTextSize(sizePx * 0.62f);
+        white.setTypeface(Typeface.create("sans-serif", Typeface.BOLD | Typeface.ITALIC));
+        white.setTextAlign(Paint.Align.CENTER);
+        Paint.FontMetrics fm = white.getFontMetrics();
+        float y = sizePx / 2f - (fm.ascent + fm.descent) / 2f;
+        canvas.drawText("b", sizePx / 2f, y, white);
+        return bmp;
+    }
+
+    /** OpenAI: the hexagonal knot, simplified to six rotated strokes. */
+    private static Bitmap openai(int sizePx) {
+        Bitmap bmp = disc(sizePx, 0xFF101013);
+        Canvas canvas = new Canvas(bmp);
+        Paint white = new Paint(Paint.ANTI_ALIAS_FLAG);
+        white.setColor(0xFFFFFFFF);
+        white.setStyle(Paint.Style.STROKE);
+        white.setStrokeWidth(sizePx * 0.10f);
+        white.setStrokeCap(Paint.Cap.ROUND);
+        float r = sizePx * 0.26f;
+        RectF oval = new RectF(-r, -r, r, r);
+        for (int i = 0; i < 6; i++) {
+            canvas.save();
+            canvas.translate(sizePx / 2f, sizePx / 2f);
+            canvas.rotate(60f * i);
+            canvas.drawArc(oval, 15f, 120f, false, white);
+            canvas.restore();
+        }
+        return bmp;
+    }
+}

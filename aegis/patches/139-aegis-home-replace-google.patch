+    // AEGIS (patch 139 v2, r97 user review): v1 looped BOTH models and
+    // opened a private NTP whenever the incognito model was empty - which
+    // is ALWAYS the case - so every tab closure spawned a private tab, and
+    // Chromium's incognito FLAG_SECURE then blocked screenshots. The guard
+    // covers the NORMAL model only now: an emptied private model simply
+    // returns to the normal model, which this guard keeps non-empty and
+    // covered by the opaque Aegis home. No Google surface, no surprise
+    // private tabs, screenshots work.
+    private final TabModelObserver mEmptyGuard =
+            new TabModelObserver() {
+                @Override
+                public void didRemoveTabForClosure(Tab tab) {
+                    if (tab.isIncognito()) return;
+                    mHandler.post(AegisHomeView.this::openNtpIfEmpty);
+                }
+            };
+
+    private void openNtpIfEmpty() {
+        if (mActivity.getTabModelSelector() == null) return;
+        TabModel normal = mActivity.getTabModelSelector().getModel(false);
+        if (normal != null && normal.getCount() == 0) {
+            mActivity.getTabCreator(false)
+                    .createNewTab(

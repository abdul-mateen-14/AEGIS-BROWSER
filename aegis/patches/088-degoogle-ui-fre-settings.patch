# 088 - De-Google UI: skip the First Run Experience (Google sign-in promo
# "Make Chrome your own", Google ToS + metrics footer), remove the Settings
# "You and Google" section (sign-in + Google services; Aegis ID lives in the
# Aegis Ecosystem page), rebrand notification strings to Aegis (permission
# rationale, UMA dialog, re-engagement notifications). Android-only files -
# desktop (.deb/.exe) targets are unaffected. Anchors count-asserted at tag
# 156.0.8078.79.

--- a/chrome/android/java/src/org/chromium/chrome/browser/firstrun/FirstRunFlowSequencer.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/firstrun/FirstRunFlowSequencer.java
@@ -266,7 +266,13 @@
                         || FirstRunStatus.getLightweightFirstRunFlowComplete())) {
             return false;
         }
-        return true;
+        // Aegis (de-Googled): no First Run Experience. The FRE welcome/sign-in
+        // screen ("Make Chrome your own"), the Google ToS + "Chrome sends usage
+        // and crash data to Google" footer and the sync opt-in pages are all
+        // Google services, so first launch goes straight to the browser. The
+        // search-engine default, notification permission and default-browser
+        // prompts are handled outside FRE.
+        return false;
     }
 

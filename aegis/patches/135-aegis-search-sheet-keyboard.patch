+    /**
+     * Patch 135 (APK review 2026-11-16): poll the visible window frame while
+     * the sheet is open. Under adjustResize the decor's visible frame bottom
+     * shrinks by exactly the keyboard height no matter who consumes insets;
+     * the baseline is the tallest frame seen (keyboard closed) and it
+     * re-baselines itself, so a flaky listener can never leave the field
+     * behind the keyboard. Values agree with the inset listeners when those
+     * do fire; self-stops once the sheet is detached.
+     */
+    private static void startKeyboardTracker(AegisSearchSheet sheet, View panel) {
+        View root = sheet.getRootView();
+        Rect frame = new Rect();
+        int[] baseline = {Integer.MIN_VALUE};
+        Runnable[] track = new Runnable[1];
+        track[0] =
+                () -> {
+                    if (sheet.getParent() == null || root.getHeight() <= 0) return;
+                    root.getWindowVisibleDisplayFrame(frame);
+                    if (baseline[0] == Integer.MIN_VALUE || frame.bottom > baseline[0]) {
+                        baseline[0] = frame.bottom; // keyboard closed (or a taller frame)
+                    }
+                    int kb = Math.max(0, baseline[0] - frame.bottom);
+                    panel.setTranslationY(-kb);
+                    sheet.postDelayed(track[0], 100);
+                };
+        sheet.post(track[0]);
     }
 
